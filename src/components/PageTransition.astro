<div id="page-transition-overlay" class="page-transition-overlay">
  <div id="page-transition-wipe" class="page-transition-wipe"></div>
</div>

<style is:inline>
  .page-transition-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 999999;
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .page-transition-wipe {
    position: absolute;
    top: -75vh;
    left: -75vw;
    width: 250vw;
    height: 250vh;
    background: linear-gradient(
      135deg,
      rgba(12, 8, 24, 0) 0%,
      rgba(12, 8, 24, 0.98) 8%,
      rgba(25, 15, 51, 1) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transform: translate3d(0, 0, 0) rotate(-45deg);
    transition: transform 0.9s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .page-transition-overlay.in {
    opacity: 1 !important;
  }

  .page-transition-overlay.in .page-transition-wipe {
    transform: translate3d(0, 0, 0) rotate(-45deg) !important;
  }

  .page-transition-overlay.out {
    opacity: 0 !important;
  }

  .page-transition-overlay.out .page-transition-wipe {
    transform: translate3d(180vw, -180vh, 0) rotate(-45deg) !important;
  }
</style>

<script is:inline>
  (function () {
    function initTransitionOut() {
      var overlay = document.getElementById("page-transition-overlay");
      var wipe = document.getElementById("page-transition-wipe");
      if (overlay && wipe) {
        // Force initial layout pass of the covered state
        overlay.offsetHeight;
        
        // Delay the start of the CSS transition on the main thread.
        // This ensures all initial rendering and hydration jank is resolved,
        // so the transition starts smoothly from 0% instead of skipping frames.
        setTimeout(function () {
          overlay.classList.add("out");
        }, 150);

        setTimeout(function () {
          overlay.classList.remove("out");
          // Reset to hidden bottom-left state after animation finishes
          overlay.style.transition = 'none';
          overlay.style.opacity = '0';
          wipe.style.transition = 'none';
          wipe.style.transform = 'translate3d(-180vw, 180vh, 0) rotate(-45deg)';
        }, 1150);
      }
    }

    // Wait for window load event so that external stylesheets are fully loaded
    // and rendering is not blocked, ensuring the transition runs smoothly.
    if (document.readyState === "complete") {
      initTransitionOut();
    } else {
      window.addEventListener("load", initTransitionOut);
    }

    document.addEventListener(
      "click",
      function (e) {
        var link = e.target.closest("a");
        if (
          link &&
          link.href &&
          link.host === window.location.host &&
          !link.hash &&
          !link.target &&
          !link.hasAttribute("download") &&
          link.getAttribute("rel") !== "external" &&
          !link.classList.contains("scrolly")
        ) {
          e.preventDefault();
          var targetUrl = link.href;

          var overlay = document.getElementById("page-transition-overlay");
          var wipe = document.getElementById("page-transition-wipe");
          if (overlay && wipe) {
            // Ensure we start from bottom-left hidden state instantly
            overlay.classList.remove("out");
            overlay.style.transition = 'none';
            overlay.style.opacity = '0';
            wipe.style.transition = 'none';
            wipe.style.transform = 'translate3d(-180vw, 180vh, 0) rotate(-45deg)';
            
            // Force reflow
            overlay.offsetHeight;
            
            // Clear inline styles to let classes control the transition
            overlay.style.transition = '';
            overlay.style.opacity = '';
            wipe.style.transition = '';
            wipe.style.transform = '';
            overlay.classList.add("in");

            setTimeout(function () {
              window.location.href = targetUrl;
            }, 850);
          } else {
            window.location.href = targetUrl;
          }
        }
      },
      true
    );
  })();
</script>