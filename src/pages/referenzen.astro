---
import logo from '../assets/rawlabs logo.png';
---
<!DOCTYPE HTML>
<html>
	<head>
		<title>Referenzen - Rawlabs Studios</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="stylesheet" href="/assets/css/main.css" />
		<noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
	</head>
	<body class="is-preload">

		<!-- Header -->
			<header id="header">
				<a href="/" class="title" style="border-bottom: none;"><img src={logo.src} alt="Rawlabs Logo" style="height: 2.5em; vertical-align: middle;" /></a>
				<nav>
					<ul>
						<li><a href="/" class="button small icon solid fa-chevron-left">Zurück zum Studio</a></li>
					</ul>
				</nav>
			</header>

		<!-- Wrapper -->
			<div id="wrapper">

				<!-- Main -->
					<section id="main" class="wrapper">
						<div class="inner">
							<h1 class="major">Alle Referenzen</h1>
							<p>Hier findest du eine Auswahl unserer bisherigen Projekte und Zusammenarbeiten.</p>
							
							<div class="references-grid">
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/pic01.jpg" alt="" />
									</div>
									<div class="reference-content">
										<h3>Vocal Recording</h3>
										<p>Wir fangen deine Stimme in höchster Qualität ein, egal ob Rap oder Gesang.</p>
									</div>
								</div>
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/pic02.jpg" alt="" />
									</div>
									<div class="reference-content">
										<h3>Sound Design</h3>
										<p>Einzigartige Sounds für deine Produktionen, von atmosphärisch bis druckvoll.</p>
									</div>
								</div>
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/pic03.jpg" alt="" />
									</div>
									<div class="reference-content">
										<h3>Studio Session</h3>
										<p>Erlebe die Atmosphäre in unserem Studio und bring deine Musik auf das nächste Level.</p>
									</div>
								</div>
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/pic04.jpg" alt="" />
									</div>
									<div class="reference-content">
										<h3>Music Video Production</h3>
										<p>Visuelle Untermalung deiner Tracks mit professionellem Color Grading und Schnitt.</p>
									</div>
								</div>
							</div>
						</div>
					</section>

			</div>

		<!-- Footer -->
			<footer id="footer" class="wrapper alt">
				<div class="inner">
					<ul class="menu">
						<li>&copy; Rawlabs Studios. Alle Rechte vorbehalten.</li><li><a href="/impressum">Impressum</a></li>
					</ul>
				</div>
			</footer>

		<!-- Scripts -->
			<script is:inline src="/assets/js/jquery.min.js"></script>
			<script is:inline src="/assets/js/jquery.scrollex.min.js"></script>
			<script is:inline src="/assets/js/jquery.scrolly.min.js"></script>
			<script is:inline src="/assets/js/browser.min.js"></script>
			<script is:inline src="/assets/js/breakpoints.min.js"></script>
			<script is:inline src="/assets/js/util.js"></script>
			<script is:inline src="/assets/js/main.js"></script>

	</body>
</html>
