---
import logo from '../assets/rawlabs logo.png';
---
<!DOCTYPE HTML>
<html>
	<head>
		<title>Künstler - Rawlabs Studios</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="stylesheet" href="/assets/css/main.css" />
		<noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
	</head>
	<body class="is-preload">

		<!-- Header -->
			<header id="header">
				<a href="/" class="title" style="border-bottom: none;"><img src={logo.src} alt="Rawlabs Logo" style="height: 2.5em; vertical-align: middle;" /></a>
				<nav>
					<ul>
						<li><a href="/" class="button small icon solid fa-chevron-left">Zurück zum Studio</a></li>
					</ul>
				</nav>
			</header>

		<!-- Wrapper -->
			<div id="wrapper">

				<!-- Main -->
					<section id="main" class="wrapper">
						<div class="inner">
							<h1 class="major">Künstler Referenzen</h1>
							<p>Hier ist eine Auswahl von großartigen Künstlern und Bands, mit denen wir eng zusammengearbeitet haben. Wir begleiten dich vom Songwriting bis zum fertigen Master.</p>
							
							<div class="references-grid">
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/album_art.png" alt="Lil Shadow Collaboration" />
									</div>
									<div class="reference-content">
										<h3>Lil Shadow</h3>
										<p>Rap/Trap Artist. Komplette Produktion, Recording und Vocal Mixing seiner 5-Track Debut EP "Shadows".</p>
									</div>
								</div>
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/album_art.png" alt="Luna & The Band Collaboration" />
									</div>
									<div class="reference-content">
										<h3>Luna & The Band</h3>
										<p>Indie Pop Band. Studio-Aufnahmen aller Live-Instrumente, Song-Strukturierung, Arrangement-Optimierung und finaler Mixdown.</p>
									</div>
								</div>
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/album_art.png" alt="Marcus V. Collaboration" />
									</div>
									<div class="reference-content">
										<h3>Marcus V.</h3>
										<p>Singer-Songwriter. Vocal Recording, Akustikgitarren-Arrangement, Songwriting-Support und anschließendes Mastering.</p>
									</div>
								</div>
							</div>
						</div>
					</section>

			</div>

		<!-- Footer -->
			<footer id="footer" class="wrapper alt">
				<div class="inner">
					<ul class="menu">
						<li>&copy; Rawlabs Studios. Alle Rechte vorbehalten.</li>
						<li><a href="/impressum">Impressum</a></li>
					</ul>
				</div>
			</footer>

		<!-- Scripts -->
			<script is:inline src="/assets/js/jquery.min.js"></script>
			<script is:inline src="/assets/js/jquery.scrollex.min.js"></script>
			<script is:inline src="/assets/js/jquery.scrolly.min.js"></script>
			<script is:inline src="/assets/js/browser.min.js"></script>
			<script is:inline src="/assets/js/breakpoints.min.js"></script>
			<script is:inline src="/assets/js/util.js"></script>
			<script is:inline src="/assets/js/main.js"></script>

	</body>
</html>
