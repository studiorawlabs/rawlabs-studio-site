									}
								</style>

								<!-- Honeypot (Spam protection) -->
								<div
									class="field"
									style="display:none !important;"
									aria-hidden="true"
								>
									<label for="website"
										>Leave this field empty</label
									>
									<input
										type="text"
										name="website"
										id="website"
										tabindex="-1"
										autocomplete="off"
									/>
								</div>
								<input
									type="hidden"
									name="form_token"
									value={Date.now()}
								/>
							</div>
							<ul class="actions">
								<li>
									<button type="submit" class="button primary"
										>Auftrag Absenden</button
									>
								</li>
							</ul>
							<div id="loading-wrapper" style="display: none; margin-top: 1em;">
								<div class="loading-container" style="display: block;">
									<div class="loading-bar"></div>
								</div>
							</div>
							<div
								id="form-status"
								style="margin-top: 1em; display: none;"
							>
							</div>
						</form>

						<script is:inline>
							// Set timestamp on load for spam protection
							document.querySelector(
								'input[name="form_token"]'
							).value = Date.now();

							// Update filename display
							const fileInput =
								document.getElementById("song_demo");
							const fileNameDisplay =
								document.getElementById("file-name-display");

							fileInput.addEventListener("change", (e) => {
								const fileName = e.target.files[0]
									? e.target.files[0].name
									: "Keine Datei ausgewählt";
								fileNameDisplay.innerText = fileName;
							});

							// Price calculation logic with rolling animation
							const addons =
								document.querySelectorAll(".addon-checkbox");
							const additionalSongsInput =
								document.getElementById("additional-songs");
							const totalPriceDisplay =
								document.getElementById("total-price");
							const packageButtonsForm =
								document.querySelectorAll(".package-btn");
							const packageInput =
								document.getElementById("package-input");
							let currentTotal = 0;

							function animateValue(obj, start, end, duration) {
								let startTimestamp = null;
								const step = (timestamp) => {
									if (!startTimestamp)
										startTimestamp = timestamp;
									const progress = Math.min(
										(timestamp - startTimestamp) / duration,
										1
									);
									obj.innerHTML = Math.floor(
										progress * (end - start) + start
									);
									if (progress < 1) {
										window.requestAnimationFrame(step);
									}
								};
								window.requestAnimationFrame(step);
							}

							function updateTotal() {
								let total = 0;
								let packagePrice = 0;
								let packageName = "Studio Paket";

								// Add package price from active button
								const activePkgBtn = document.querySelector(
									".package-btn.active"
								);
								if (activePkgBtn) {
									packagePrice = parseInt(
										activePkgBtn.dataset.price || 0
									);
									// Extract just the name, strip the price " (XX€)"
									packageName =
										activePkgBtn.innerText.replace(
											/\s*\(\d+€\)/,
											""
										);
								}

								const additionalSongsCount =
									additionalSongsInput
										? parseInt(
												additionalSongsInput.value || 0
										  )
										: 0;

								const totalSongs = 1 + additionalSongsCount;
								const songsSubtotal = packagePrice * totalSongs;
								let addonsSubtotal = 0;

								let breakdownHtml = `<div class="breakdown-row"><span><span class="breakdown-qty">${totalSongs}</span> <span class="breakdown-divider">|</span> ${packageName}</span><span>${songsSubtotal}€</span></div>`;

								// Add selected add-ons price (Express scales with total number of songs)
								addons.forEach((cb) => {
									if (cb.checked) {
										const basePrice = parseInt(
											cb.dataset.price || 0
										);

										// Get label text dynamically
										const labelElem =
											document.querySelector(
												`label[for="${cb.id}"]`
											);
										let addonLabel = labelElem
											? labelElem.innerText
													.split("(")[0]
													.trim()
											: cb.value;
										// For express, extract clean name
										if (cb.id === "addon-express")
											addonLabel = "Express-Lieferung";

										if (cb.id === "addon-express") {
											const addonTotal =
												basePrice * totalSongs;
											addonsSubtotal += addonTotal;
											breakdownHtml += `<div class="breakdown-row"><span><span class="breakdown-qty">${totalSongs}</span> <span class="breakdown-divider">|</span> ${addonLabel}</span><span>${addonTotal}€</span></div>`;
										} else {
											addonsSubtotal += basePrice;
											breakdownHtml += `<div class="breakdown-row"><span><span class="breakdown-qty">1</span> <span class="breakdown-divider">|</span> ${addonLabel}</span><span>${basePrice}€</span></div>`;
										}
									}
								});

								// Apply tiered discount (ONLY to the songs portion!)
								let discountPct = 0;
								if (totalSongs >= 5) discountPct = 0.2;
								else if (totalSongs >= 3) discountPct = 0.15;
								else if (totalSongs == 2) discountPct = 0.05;

								const preDiscountSubtotal =
									songsSubtotal + addonsSubtotal;
								let discountValue = 0;
								if (discountPct > 0) {
									discountValue = Math.round(
										songsSubtotal * discountPct
									);
								}

								total = preDiscountSubtotal - discountValue;

								if (total !== currentTotal) {
									animateValue(
										totalPriceDisplay,
										currentTotal,
										total,
										300
									);
									currentTotal = total;
								}

								// Update discount display
								const discountRow =
									document.getElementById("discount-row");
								const discountAmountDisplay =
									document.getElementById("discount-amount");
								const subtotalRow =
									document.getElementById("subtotal-row");
								const subtotalDisplay =
									document.getElementById("subtotal-price");
								if (discountRow && discountAmountDisplay) {
									if (discountValue > 0) {
										discountRow.style.display = "flex";
										discountAmountDisplay.innerText =
											discountValue;
										if (subtotalRow && subtotalDisplay) {
											subtotalRow.style.display = "flex";
											subtotalDisplay.innerText =
												preDiscountSubtotal;
										}
									} else {
										discountRow.style.display = "none";
										if (subtotalRow)
											subtotalRow.style.display = "none";
									}
								}

								// Update breakdown display
								const breakdownDisplay =
									document.getElementById("price-breakdown");
								if (breakdownDisplay) {
									breakdownDisplay.innerHTML = breakdownHtml;
									breakdownDisplay.style.display = "block";
								}

								// Check if total is >= 250 to enforce billing address
								const hasAddressCheckbox = document.getElementById("has-address");
								const addressFieldsWrapper = document.getElementById("address-fields-wrapper");
								
								if (hasAddressCheckbox && addressFieldsWrapper) {
									if (total >= 250) {
										hasAddressCheckbox.checked = true;
										hasAddressCheckbox.disabled = true;
										addressFieldsWrapper.classList.add("open");
										document.getElementById("address-toggle-label").innerHTML = `Rechnungsadresse angeben <span style="font-weight: normal; font-size: 0.85em; color: #f44336;">(Erforderlich, da über 250€)</span>`;
									} else {
										hasAddressCheckbox.disabled = false;
										if (!hasAddressCheckbox.checked) {
											addressFieldsWrapper.classList.remove("open");
										}
										document.getElementById("address-toggle-label").innerHTML = `Rechnungsadresse angeben <span style="font-weight: normal; font-size: 0.85em; opacity: 0.6;">(erforderlich ab 250€)</span>`;
									}
								}
							}

							packageButtonsForm.forEach((btn) => {
								btn.addEventListener("click", () => {
									packageButtonsForm.forEach((b) =>
										b.classList.remove("active")
									);
									btn.classList.add("active");
									if (packageInput) {
										packageInput.value = btn.dataset.value;
									}
									updateTotal();
									updateSongsLabel();
								});
							});

							addons.forEach((cb) => {
								cb.addEventListener("change", updateTotal);
							});

							if (additionalSongsInput) {
								additionalSongsInput.addEventListener(
									"input",
									() => {
										updateTotal();
										updateSongsLabel();
									}
								);
								additionalSongsInput.addEventListener(
									"change",
									() => {
										updateTotal();
										updateSongsLabel();
									}
								);
							}

							function updateSongsLabel() {
								const songsCount = parseInt(
									additionalSongsInput.value || 0
								);
								const label =
									document.getElementById("songs-label");

								if (!label) return;

								if (songsCount === 0) {
									label.innerHTML = `Zusätzliche Songs (Mengenrabatt ab 2 Songs):<br><span style="font-weight: normal; color: rgba(255,255,255,0.4)">Keine</span>`;
								} else {
									const totalSongs = 1 + songsCount;
									let discountStr = "";
									if (totalSongs >= 5) discountStr = "20%";
									else if (totalSongs >= 3)
										discountStr = "15%";
									else if (totalSongs == 2)
										discountStr = "5%";

									const songText =
										songsCount === 1
											? "1 zusätzlicher Song"
											: `${songsCount} zusätzliche Songs`;
									label.innerHTML = `Zusätzliche Songs (Mengenrabatt ab 2 Songs):<br><span style="display: inline-block; color: #a891ff; font-weight: normal; animation: pulse 0.3s ease;">${songText} (-${discountStr})</span>`;
								}

								// Dynamically scale Express price label preserving custom HTML modifications
								const expressLabel =
									document.getElementById("express-label");
								if (expressLabel) {
									const expressCheckbox =
										document.getElementById(
											"addon-express"
										);
									const baseExpressPrice = expressCheckbox
										? parseInt(
												expressCheckbox.dataset.price ||
													50
										  )
										: 50;
									const totalExpressPrice =
										baseExpressPrice * (1 + songsCount);
									// Use regex to only replace the (+XX€) part, leaving text like "72h" untouched!
									expressLabel.innerHTML =
										expressLabel.innerHTML.replace(
											/\(\+\d+€\)/,
											`(+${totalExpressPrice}€)`
										);
								}
							}

							// Handle package card selection clicks
							const packageButtons =
								document.querySelectorAll("[data-package]");
							packageButtons.forEach((btn) => {
								btn.addEventListener("click", () => {
									const targetPackage = btn.dataset.package;
									let targetValue = "";

									if (targetPackage === "essentials") {
										targetValue = "Raw Labs Essentials";
									} else if (targetPackage === "advanced") {
										targetValue = "Raw Labs Advanced";
									} else if (targetPackage === "ultimate") {
										targetValue = "Raw Labs Ultimate";
									}

									const targetBtn = Array.from(
										packageButtonsForm
									).find(
										(b) => b.dataset.value === targetValue
									);
									if (targetBtn) {
										targetBtn.click();
									}
								});
							});

							const isB2bCheckbox = document.getElementById("is-b2b");
							const b2bFieldsWrapper = document.getElementById("b2b-fields-wrapper");
							const companyNameInput = document.getElementById("company_name");

							isB2bCheckbox.addEventListener("change", () => {
								if (isB2bCheckbox.checked) {
									b2bFieldsWrapper.classList.add("open");
									companyNameInput.required = true;
								} else {
									b2bFieldsWrapper.classList.remove("open");
									companyNameInput.required = false;
									companyNameInput.value = "";
									document.getElementById("vat_number").value = "";
								}
							});

							const hasAddressCheckbox = document.getElementById("has-address");
							const addressFieldsWrapper = document.getElementById("address-fields-wrapper");

							hasAddressCheckbox.addEventListener("change", () => {
								if (hasAddressCheckbox.checked) {
									addressFieldsWrapper.classList.add("open");
								} else {
									addressFieldsWrapper.classList.remove("open");
									// Clear address fields if unchecked
									document.getElementById("street").value = "";
									document.getElementById("zip").value = "";
									document.getElementById("city").value = "";
									document.getElementById("country").value = "DE";
								}
							});

							// Calculate initial total
							updateTotal();
							updateSongsLabel();

							const form =
								document.getElementById("contact-form");
							const status =
								document.getElementById("form-status");

							form.addEventListener("submit", async (e) => {
								e.preventDefault();

								// Disable submit button and show loading bar
								const submitBtn = form.querySelector('button[type="submit"]');
								const loadingWrapper = document.getElementById("loading-wrapper");
								
								submitBtn.disabled = true;
								loadingWrapper.style.display = "block";

								// Validation: Billing address is required for amounts >= 250€ or if checkbox is checked
								const hasAddress = hasAddressCheckbox.checked;
								const streetVal = document.getElementById("street").value.trim();
								const zipVal = document.getElementById("zip").value.trim();
								const cityVal = document.getElementById("city").value.trim();

								if (currentTotal >= 250 && (!hasAddress || !streetVal || !zipVal || !cityVal)) {
									submitBtn.disabled = false;
									loadingWrapper.style.display = "none";
									status.style.display = "block";
									status.style.color = "#f44336";
									status.innerText = "Bitte Rechnungsadresse ausfüllen. Bei Beträgen über 250€ ist eine Rechnungsadresse gesetzlich erforderlich.";
									
									hasAddressCheckbox.checked = true;
									addressFieldsWrapper.classList.add("open");
									
									const firstEmptyField = !streetVal ? "street" : (!zipVal ? "zip" : "city");
									document.getElementById(firstEmptyField).focus();
									return;
								}

								if (hasAddress && (!streetVal || !zipVal || !cityVal)) {
									submitBtn.disabled = false;
									loadingWrapper.style.display = "none";
									status.style.display = "block";
									status.style.color = "#f44336";
									status.innerText = "Bitte fülle alle Pflichtfelder der Rechnungsadresse aus.";
									
									const firstEmptyField = !streetVal ? "street" : (!zipVal ? "zip" : "city");
									document.getElementById(firstEmptyField).focus();
									return;
								}

								status.style.display = "block";
								status.style.color = "#fff";
								status.innerText = "Wird gesendet...";

								const formData = new FormData(form);

								try {
									const response = await fetch(
										"/api/contact",
										{
											method: "POST",
											body: formData, // Sending raw FormData handles the file automatically
										}
									);

									const result = await response.json();

									if (response.ok) {
										status.style.color = "#4CAF50";
										status.innerText =
											"Erfolgreich gesendet! Wir melden uns bei dir.";
										form.reset();
										
										// Reset B2B state
										b2bFieldsWrapper.classList.remove("open");
										companyNameInput.required = false;

										// Reset Address state
										addressFieldsWrapper.classList.remove("open");
										hasAddressCheckbox.disabled = false;
										document.getElementById("address-toggle-label").innerHTML = `Rechnungsadresse angeben <span style="font-weight: normal; font-size: 0.85em; opacity: 0.6;">(erforderlich ab 250€)</span>`;
									} else {
										status.style.color = "#f44336";
										status.innerText =
											result.message ||
											"Etwas ist schiefgelaufen.";
									}
								} catch (error) {
									status.style.color = "#f44336";
									status.innerText =
										"Fehler bei der Verbindung zum Server.";
								} finally {
									// Re-enable button and hide loading bar
									submitBtn.disabled = false;
									loadingWrapper.style.display = "none";
								}
							});
						</script>
					</section>
					<section>
						<ul class="contact">
							<li>
								<h3>Email</h3>
								<a href="mailto:info@rawlabs-studio.com"
									>info@rawlabs-studio.com</a
								>
							</li>
							<li>
								<h3>Social</h3>
								<ul class="icons">
									<li>
										<a
											href="https://www.instagram.com/rawlabs_studios/"
											class="icon brands fa-instagram"
											><span class="label">Instagram</span
											>
										</a>
									</li>
								</ul>
							</li>
						</ul>
					</section>
				</div>
			</div>
		</section>
	</div>

	<!-- Footer -->
	<footer id="footer" class="wrapper style1-alt">
		<div class="inner">
			<ul class="menu">
				<li>&copy; Rawlabs Studios. Alle Rechte vorbehalten.</li><li>
					<a href="/impressum">Impressum</a>
				</li>
			</ul>
		</div>
	</footer>

	<!-- Scripts -->
	<script is:inline src="/assets/js/jquery.min.js"></script>
	<script is:inline src="/assets/js/jquery.scrollex.min.js"></script>
	<script is:inline src="/assets/js/jquery.scrolly.min.js"></script>
	<script is:inline src="/assets/js/browser.min.js"></script>
	<script is:inline src="/assets/js/breakpoints.min.js"></script>
