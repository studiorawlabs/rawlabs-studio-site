										box-shadow: 0 0 10px
											rgba(168, 145, 255, 0.5) !important;
										border: none !important;
										transition: transform 0.1s ease,
											background-color 0.2s ease;
									}

									.songs-slider::-webkit-slider-thumb:hover {
										transform: scale(1.2) !important;
										background: #bfaaff !important;
										box-shadow: 0 0 15px
											rgba(168, 145, 255, 0.8) !important;
									}

									.songs-slider::-moz-range-track {
										width: 100% !important;
										height: 6px !important;
										cursor: pointer !important;
										border-radius: 5px !important;
										background: rgba(
											255,
											255,
											255,
											0.1
										) !important;
										border: none !important;
									}

									.songs-slider::-moz-range-thumb {
										height: 20px !important;
										width: 20px !important;
										border-radius: 50% !important;
										background: #a891ff !important;
										cursor: pointer !important;
										box-shadow: 0 0 10px
											rgba(168, 145, 255, 0.5) !important;
										border: none !important;
										transition: transform 0.1s ease,
											background-color 0.2s ease;
									}

									.songs-slider::-moz-range-thumb:hover {
										transform: scale(1.2) !important;
										background: #bfaaff !important;
