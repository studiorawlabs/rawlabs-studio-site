										cursor: pointer !important;
									}

									.package-btn.active {
										background: rgba(
											168,
											145,
											255,
											0.1
										) !important;
										border-color: #a891ff !important;
										color: #fff !important;
										box-shadow: 0 0 20px 2px
											rgba(168, 145, 255, 0.7) !important;
									}

									/* Custom Animated Checkbox Styling */
									.checkbox-item {
										display: flex;
										align-items: center;
										margin: 0.5em 0;
										overflow: visible !important;
									}

									input[type="checkbox"].addon-checkbox {
										position: absolute;
										opacity: 0;
										pointer-events: none;
									}

									input[type="checkbox"].addon-checkbox
										+ label {
										position: relative;
										padding-left: 2.25em !important;
										cursor: pointer !important;
										user-select: none;
										display: inline-block;
										color: rgba(
											255,
											255,
											255,
											0.7
										) !important;
										transition: color 0.3s ease !important;
										text-transform: none !important;
										font-weight: 500 !important;
									}

									input[type="checkbox"].addon-checkbox:checked
										+ label {
										color: #fff !important;
									}

									/* Custom checkbox outer box */
									input[type="checkbox"].addon-checkbox
										+ label::before {
										content: "" !important;
										position: absolute;
										left: 0;
										top: 50%;
										transform: translateY(-50%) !important;
										width: 22px !important;
										height: 22px !important;
										background: rgba(
											255,
											255,
											255,
											0.04
										) !important;
										border: 1px solid
											rgba(255, 255, 255, 0.15) !important;
										border-radius: 6px !important;
										transition: all 0.3s
											cubic-bezier(0.4, 0, 0.2, 1) !important;
										box-shadow: none !important;
									}

									/* Custom checkbox checkmark */
									input[type="checkbox"].addon-checkbox
										+ label::after {
										content: "" !important;
										position: absolute;
										left: 8px;
										top: calc(50% - 6px);
										width: 6px !important;
										height: 11px !important;
										border: solid #fff !important;
										border-width: 0 2px 2px 0 !important;
										transform: rotate(45deg) scale(0) !important;
										transition: transform 0.35s
											cubic-bezier(
												0.175,
												0.885,
												0.32,
												1.5
											) !important;
										transform-origin: center !important;
									}

									/* Checked state: glowing background & border */
									input[type="checkbox"].addon-checkbox:checked
										+ label::before {
										background: rgba(
											168,
											145,
											255,
											0.25
										) !important;
										border-color: #a891ff !important;
										box-shadow: 0 0 12px
											rgba(168, 145, 255, 0.5) !important;
									}

									/* Checked state: animate checkmark in */
									input[type="checkbox"].addon-checkbox:checked
										+ label::after {
										transform: rotate(45deg) scale(1) !important;
										border-color: #a891ff !important;
									}

									/* Hover state interaction */
									input[type="checkbox"].addon-checkbox
										+ label:hover::before {
										border-color: rgba(
											168,
											145,
											255,
											0.5
										) !important;
										background: rgba(
											255,
											255,
											255,
											0.08
										) !important;
									}
								</style>

								<!-- Honeypot (Spam protection) -->
								<div
									class="field"
									style="display:none !important;"
									aria-hidden="true"
								>
									<label for="website"
										>Leave this field empty</label
									>
									<input
										type="text"
										name="website"
										id="website"
										tabindex="-1"
										autocomplete="off"
									/>
								</div>
								<input
									type="hidden"
									name="form_token"
									value={Date.now()}
								/>
							</div>
							<ul class="actions">
								<li>
									<button type="submit" class="button primary"
										>Nachricht senden</button
									>
								</li>
							</ul>
							<div
								id="form-status"
								style="margin-top: 1em; display: none;"
							>
							</div>
						</form>

						<script is:inline>
							// Set timestamp on load for spam protection
							document.querySelector(
								'input[name="form_token"]'
							).value = Date.now();

							// Update filename display
							const fileInput =
								document.getElementById("song_demo");
							const fileNameDisplay =
								document.getElementById("file-name-display");

							fileInput.addEventListener("change", (e) => {
								const fileName = e.target.files[0]
									? e.target.files[0].name
									: "Keine Datei ausgewählt";
								fileNameDisplay.innerText = fileName;
							});

							// Price calculation logic with rolling animation
							const addons =
								document.querySelectorAll(".addon-checkbox");
							const additionalSongsInput =
								document.getElementById("additional-songs");
							const totalPriceDisplay =
								document.getElementById("total-price");
							const packageButtonsForm =
								document.querySelectorAll(".package-btn");
							const packageInput =
								document.getElementById("package-input");
							let currentTotal = 0;

							function animateValue(obj, start, end, duration) {
								let startTimestamp = null;
								const step = (timestamp) => {
									if (!startTimestamp)
										startTimestamp = timestamp;
									const progress = Math.min(
										(timestamp - startTimestamp) / duration,
										1
									);
									obj.innerHTML = Math.floor(
										progress * (end - start) + start
									);
									if (progress < 1) {
										window.requestAnimationFrame(step);
									}
								};
								window.requestAnimationFrame(step);
							}

							function updateTotal() {
								let total = 0;
								let packagePrice = 0;

								// Add package price from active button
								const activePkgBtn = document.querySelector(
									".package-btn.active"
								);
								if (activePkgBtn) {
									packagePrice = parseInt(
										activePkgBtn.dataset.price || 0
									);
									total += packagePrice;
								}

								const additionalSongsCount =
									additionalSongsInput
										? parseInt(
												additionalSongsInput.value || 0
										  )
										: 0;

								// Add selected add-ons price (Express scales with total number of songs: 1 + additional songs)
								addons.forEach((cb) => {
									if (cb.checked) {
										const basePrice = parseInt(
											cb.dataset.price || 0
										);
										if (cb.id === "addon-express") {
											total +=
												basePrice *
												(1 + additionalSongsCount);
										} else {
											total += basePrice;
										}
									}
								});

								// Add additional songs price (each at 80% of the package price)
								if (
									additionalSongsCount > 0 &&
									packagePrice > 0
								) {
									total += Math.round(
										additionalSongsCount *
											packagePrice *
											0.8
									);
								}

								if (total !== currentTotal) {
									animateValue(
										totalPriceDisplay,
										currentTotal,
										total,
										300
									);
									currentTotal = total;
								}
							}

							packageButtonsForm.forEach((btn) => {
								btn.addEventListener("click", () => {
									packageButtonsForm.forEach((b) =>
										b.classList.remove("active")
									);
									btn.classList.add("active");
									if (packageInput) {
										packageInput.value = btn.dataset.value;
									}
									updateTotal();
									updateSongsLabel();
								});
							});

							addons.forEach((cb) => {
								cb.addEventListener("change", updateTotal);
							});

							if (additionalSongsInput) {
								additionalSongsInput.addEventListener(
									"input",
									() => {
										updateTotal();
										updateSongsLabel();
									}
								);
								additionalSongsInput.addEventListener(
									"change",
									() => {
										updateTotal();
										updateSongsLabel();
									}
								);
							}

							function updateSongsLabel() {
								const songsCount = parseInt(
									additionalSongsInput.value || 0
								);
								const activePkgBtn = document.querySelector(
									".package-btn.active"
								);
								const packagePrice = activePkgBtn
									? parseInt(activePkgBtn.dataset.price || 0)
									: 0;
								const label =
									document.getElementById("songs-label");

								if (!label) return;

								if (songsCount === 0) {
									label.innerHTML = `Zusätzliche Songs (mit 20% Rabatt):<br><strong style="color: rgba(255,255,255,0.4)">Keine</strong>`;
								} else {
									const extraCost = Math.round(
										songsCount * packagePrice * 0.8
									);
									const songText =
										songsCount === 1
											? "1 Song"
											: `${songsCount} Songs`;
									label.innerHTML = `Zusätzliche Songs (mit 20% Rabatt):<br><span style="display: inline-block; color: #a891ff; font-weight: 800; animation: pulse 0.3s ease;">${songText} (+${extraCost}€)</span>`;
								}

								// Dynamically scale Express price label preserving custom HTML modifications
								const expressLabel =
									document.getElementById("express-label");
								if (expressLabel) {
									const expressCheckbox = document.getElementById("addon-express");
									const baseExpressPrice = expressCheckbox ? parseInt(expressCheckbox.dataset.price || 50) : 50;
									const totalExpressPrice =
										baseExpressPrice * (1 + songsCount);
									// Use regex to only replace the (+XX€) part, leaving text like "72h" untouched!
									expressLabel.innerHTML =
										expressLabel.innerHTML.replace(
											/\(\+\d+€\)/,
											`(+${totalExpressPrice}€)`
										);
								}
							}

							// Handle package card selection clicks
							const packageButtons =
								document.querySelectorAll("[data-package]");
							packageButtons.forEach((btn) => {
								btn.addEventListener("click", () => {
									const targetPackage = btn.dataset.package;
									let targetValue = "";

									if (targetPackage === "essentials") {
										targetValue = "Raw Labs Essentials";
									} else if (targetPackage === "advanced") {
										targetValue = "Raw Labs Advanced";
									} else if (targetPackage === "ultimate") {
										targetValue = "Raw Labs Ultimate";
									}

									const targetBtn = Array.from(
										packageButtonsForm
									).find(
										(b) => b.dataset.value === targetValue
									);
									if (targetBtn) {
										targetBtn.click();
									}
								});
							});

							// Calculate initial total
							updateTotal();
							updateSongsLabel();

							const form =
								document.getElementById("contact-form");
							const status =
								document.getElementById("form-status");

							form.addEventListener("submit", async (e) => {
								e.preventDefault();

								status.style.display = "block";
								status.style.color = "#fff";
								status.innerText = "Wird gesendet...";

								const formData = new FormData(form);

								try {
									const response = await fetch(
										"/api/contact",
										{
											method: "POST",
											body: formData, // Sending raw FormData handles the file automatically
										}
									);

									const result = await response.json();

									if (response.ok) {
										status.style.color = "#4CAF50";
										status.innerText =
											"Erfolgreich gesendet! Wir melden uns bei dir.";
										form.reset();
									} else {
										status.style.color = "#f44336";
										status.innerText =
											result.message ||
											"Etwas ist schiefgelaufen.";
									}
								} catch (error) {
									status.style.color = "#f44336";
									status.innerText =
										"Fehler bei der Verbindung zum Server.";
								}
							});
						</script>
					</section>
					<section>
						<ul class="contact">
							<li>
								<h3>Email</h3>
								<a href="mailto:info@rawlabs-studio.com"
									>info@rawlabs-studio.com</a
								>
							</li>
							<li>
								<h3>Social</h3>
								<ul class="icons">
									<li>
										<a
											href="https://www.instagram.com/rawlabs_studios/"
											class="icon brands fa-instagram"
											><span class="label">Instagram</span
											>
										</a>
									</li>
								</ul>
							</li>
						</ul>
					</section>
				</div>
			</div>
		</section>
	</div>

	<!-- Footer -->
	<footer id="footer" class="wrapper style1-alt">
		<div class="inner">
			<ul class="menu">
				<li>&copy; Rawlabs Studios. Alle Rechte vorbehalten.</li><li>
					<a href="/generic">Impressum</a>
				</li>
			</ul>
		</div>
	</footer>

