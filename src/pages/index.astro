---
import logo from "../assets/rawlabs logo.png";
import CookieBanner from "../components/CookieBanner.astro";
---

<!DOCTYPE html>
<head>
	<title>Rawlabs Studios</title>
	<meta charset="utf-8" />
	<meta
		name="viewport"
		content="width=device-width, initial-scale=1, user-scalable=no"
	/>
	<link rel="icon" type="image/png" href="/logo.png" />
	<link rel="stylesheet" href="/assets/css/main.css" />
	<noscript
		><link rel="stylesheet" href="/assets/css/noscript.css" />
	</noscript>
</head>
<body class="is-preload">
	<!-- Sidebar -->
	<section id="sidebar">
		<div class="inner">
			<a href="/" class="sidebar-logo-link"
				><img src={logo.src} alt="Rawlabs Logo" class="sidebar-logo" />
			</a>
			<nav>
				<ul>
					<li><a href="#intro">Studio</a></li>
					<li><a href="#two">Referenzen</a></li>
					<li><a href="#three">Services</a></li>
					<li><a href="#packages">Pakete</a></li>
					<li><a href="/contact">Kontaktiere uns</a></li>
				</ul>
			</nav>
		</div>
	</section>

	<!-- Wrapper -->
	<div id="wrapper">
		<!-- Intro -->
		<section id="intro" class="wrapper style1 fullscreen fade-up">
			<div class="inner">
				<h1>Willkommen im Studio!</h1>
				<p>Von Home zu High-End</p>
				<ul class="actions intro-actions">
					<li>
						<a href="#two" class="button scrolly"
							>Schau dir unsere Arbeit an!</a
						>
					</li>
					<li class="button-separator">oder</li>
					<li>
						<a href="/contact" class="button"
							>Sende uns deine Demo!</a
						>
					</li>
				</ul>
			</div>
		</section>

		<!-- Two -->
		<section id="two" class="wrapper style2">
			<div class="inner">
				<h2>Referenzen</h2>
				<div class="references-grid">
					<div class="reference-item">
						<div class="reference-image">
							<img
								src="/images/mixes_masters.png"
								alt="Mixes & Masters"
							/>
						</div>
						<div class="reference-content">
							<h3>Mixes / Masters</h3>
							<p>
								Check unsere Spotify Playlist mit Songs an denen
								wir mitgearbetet haben!
							</p>
							<ul class="actions">
								<li>
									<a
										href="/under-construction"
										class="button">Details</a
									>
								</li>
							</ul>
						</div>
					</div>
					<div class="reference-item">
						<div class="reference-image">
							<img
								src="/images/beats_arrangements.png"
								alt="Beats & Arrangements"
							/>
						</div>
						<div class="reference-content">
							<h3>Beats / Arrangements</h3>
							<p>Beatproduktionen von Rawlabs!</p>
							<ul class="actions">
								<li>
									<a
										href="/under-construction"
										class="button">Details</a
									>
								</li>
							</ul>
						</div>
					</div>
					<div class="reference-item">
						<div class="reference-image">
							<img src="/images/kuenstler.png" alt="Künstler" />
						</div>
						<div class="reference-content">
							<h3>Künstler</h3>
							<p>Künstler mit denen wir gearbeitet haben!</p>
							<ul class="actions">
								<li>
									<a
										href="/under-construction"
										class="button">Details</a
									>
								</li>
							</ul>
						</div>
					</div>
				</div>
				<ul class="actions special" style="margin-top: 3em;">
					<li>
						<a href="/under-construction" class="button"
							>Mehr Referenzen ansehen</a
						>
					</li>
				</ul>
			</div>
		</section>

		<!-- Three -->
		<section id="three" class="wrapper style3 fade-up">
			<div class="inner">
				<h2>Unsere Services</h2>
				<p>
					Wir helfen mit allem, was dein Song braucht, um auf die
					nächste Stufe zu kommen.<br /><br />Dein Sound, so wie du
					ihn dir vorstellst. <br />Dein Auftritt, so wie du als
					artist gesehen werden willst.
				</p>
				<div class="services-list">
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-sliders-h"></span>
						</div>
						<div class="service-details">
							<h3>Mixing</h3>
							<p>Professionelles Mixing von bis zu 15 Stems.</p>
							<a href="/contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-wave-square"
							></span>
						</div>
						<div class="service-details">
							<h3>Mastering</h3>
							<p>
								Professionelles Mastering um jeden Track radio
								ready zu machen.
							</p>
							<a href="/contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-drum"></span>
						</div>
						<div class="service-details">
							<h3>Beat Production</h3>
							<p>
								Individuelle Beat Produktion für Genres von Hip
								Hop, Rap, RnB bis hin zu Pop
							</p>
							<a href="/contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-palette"></span>
						</div>
						<div class="service-details">
							<h3>Assets</h3>
							<p>
								Von Album Artwork bis hin zu Social Media
								Graphics, wir kümmern uns darum
							</p>
							<a href="/contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Packages -->
		<section id="packages" class="wrapper style3 fade-up">
			<div class="inner">
				<h2>Unsere Pakete</h2>
				<p>Wähle das passende Paket für dein Projekt.</p>
				<div class="pricing-grid">
					<!-- Essentials -->
					<div class="pricing-card">
						<h3>Essentials</h3>
						<ul class="pricing-features">
							<li>
								Beat Track <span class="detail"
									>(Stereo-Spur)</span
								>
							</li>
							<li>
								3 Vocal Stems <span class="detail"
									>(z.B. 1 Lead + 2 Doubles)</span
								>
							</li>
							<li>Standard Vocal Tuning, Leveling & Mixing</li>
							<li class="plus">Mastering Inklusive</li>
						</ul>
						<a
							href="/contact?package=essentials"
							class="button"
							data-package="essentials">Ab 30€</a
						>
					</div>

					<!-- Advanced -->
					<div class="pricing-card popular">
						<div class="popular-badge">Am beliebtesten!</div>
						<h3>Advanced</h3>
						<ul class="pricing-features">
							<li>
								Beat Track <span class="detail"
									>(Stereo-Spur)</span
								>
							</li>
							<li>
								7 Vocal Stems <span class="detail"
									>(z.B. 2 Leads, 4 Doubles, 1 Adlibs)</span
								>
							</li>
							<li>Standard Vocal Tuning, Leveling & Mixing</li>
							<li class="plus">Mastering Inklusive</li>
						</ul>
						<a
							href="/contact?package=advanced"
							class="button primary"
							data-package="advanced">Ab 60€</a
						>
					</div>

					<!-- Ultimate -->
					<div class="pricing-card">
						<h3>Ultimate</h3>
						<ul class="pricing-features">
							<li>
								Beat Track inkl. Mixing <span class="detail"
									>(Bis zu 18 Multitracks)</span
								>
							</li>
							<li>
								12 Vocal Stems <span class="detail"
									>(bis zu 12 Spuren)</span
								>
							</li>
							<li>Manuelle Pitch und Timing Correction</li>
							<li class="plus">Mastering Inklusive</li>
						</ul>
						<a
							href="/contact?package=ultimate"
							class="button"
							data-package="ultimate">Ab 150€</a
						>
					</div>
				</div>
			</div>
		</section>

				<div class="split style1">
					<section>
						<h3>Bereit, deinen Sound auf das nächste Level zu bringen?</h3>
						<p>Nutze unser neues, interaktives Bestellformular, um uns deine Demo zu senden und dein Projekt individuell zu konfigurieren.</p>
						<ul class="actions">
							<li><a href="/contact" class="button primary glowing-button">Jetzt Projekt anfragen</a></li>
						</ul>
					</section>

					<section>
						<ul class="contact">
							<li>
								<h3>Email</h3>
								<a href="mailto:info@rawlabs-studio.com"
									>info@rawlabs-studio.com</a
								>
							</li>
							<li>
								<h3>Social</h3>
								<ul class="icons">
									<li>
										<a
											href="https://www.instagram.com/rawlabs_studios/"
											class="icon brands fa-instagram"
											><span class="label">Instagram</span
											>
										</a>
									</li>
								</ul>
							</li>
						</ul>
					</section>
				</div>
			</div>
		</section>
	</div>

	<!-- Footer -->
	<footer id="footer" class="wrapper style1-alt">
		<div class="inner">
			<ul class="menu">
				<li>&copy; Rawlabs Studios. Alle Rechte vorbehalten.</li><li>
					<a href="/impressum">Impressum</a>
				</li>
			</ul>
		</div>
	</footer>

	<!-- Scripts -->
	<script is:inline src="/assets/js/jquery.min.js"></script>
	<script is:inline src="/assets/js/jquery.scrollex.min.js"></script>
	<script is:inline src="/assets/js/jquery.scrolly.min.js"></script>
	<script is:inline src="/assets/js/browser.min.js"></script>
	<script is:inline src="/assets/js/breakpoints.min.js"></script>
	<script is:inline src="/assets/js/util.js"></script>
	<script is:inline src="/assets/js/main.js"></script>
	<CookieBanner />
</body>

<style>
	.glowing-button {
		position: relative;
		background: #a891ff !important;
		color: #fff !important;
		border-color: #a891ff !important;
		box-shadow: 0 0 15px rgba(168, 145, 255, 0.5) !important;
		transition: all 0.3s ease !important;
		font-weight: bold !important;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.glowing-button:hover {
		box-shadow: 0 0 25px rgba(168, 145, 255, 0.95), 0 0 40px rgba(168, 145, 255, 0.4) !important;
		transform: translateY(-2px);
	}
</style>
