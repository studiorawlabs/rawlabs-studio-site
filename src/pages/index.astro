---
import logo from "../assets/rawlabs logo.png";
import CookieBanner from "../components/CookieBanner.astro";
---

<!DOCTYPE html>
<head>
	<title>Rawlabs Studios</title>
	<meta charset="utf-8" />
	<meta
		name="viewport"
		content="width=device-width, initial-scale=1, user-scalable=no"
	/>
	<link rel="icon" type="image/png" href="/logo.png" />
	<link rel="stylesheet" href="/assets/css/main.css" />
	<noscript
		><link rel="stylesheet" href="/assets/css/noscript.css" />
	</noscript>
</head>
<body class="is-preload">
	<!-- Sidebar -->
	<section id="sidebar">
		<div class="inner">
			<a href="/" class="sidebar-logo-link"
				><img src={logo.src} alt="Rawlabs Logo" class="sidebar-logo" />
			</a>
			<nav>
				<ul>
					<li><a href="#intro">Studio</a></li>
					<li><a href="#two">Referenzen</a></li>
					<li><a href="#three">Services</a></li>
					<li><a href="#packages">Pakete</a></li>
					<li><a href="#contact">Kontaktiere uns</a></li>
				</ul>
			</nav>
		</div>
	</section>

	<!-- Wrapper -->
	<div id="wrapper">
		<!-- Intro -->
		<section id="intro" class="wrapper style1 fullscreen fade-up">
			<div class="inner">
				<h1>Willkommen im Studio!</h1>
				<p>Von Home zu High-End</p>
				<ul class="actions intro-actions">
					<li>
						<a href="#two" class="button scrolly"
							>Schau dir unsere Arbeit an!</a
						>
					</li>
					<li class="button-separator">oder</li>
					<li>
						<a href="#contact" class="button scrolly"
							>Sende uns deine Demo!</a
						>
					</li>
				</ul>
			</div>
		</section>

		<!-- Two -->
		<section id="two" class="wrapper style2">
			<div class="inner">
				<h2>Referenzen</h2>
				<div class="references-grid">
					<div class="reference-item">
						<div class="reference-image">
							<img
								src="/images/mixes_masters.png"
								alt="Mixes & Masters"
							/>
						</div>
						<div class="reference-content">
							<h3>Mixes / Masters</h3>
							<p>
								Check unsere Spotify Playlist mit Songs an denen
								wir mitgearbetet haben!
							</p>
							<ul class="actions">
								<li>
									<a
										href="/under-construction"
										class="button">Details</a
									>
								</li>
							</ul>
						</div>
					</div>
					<div class="reference-item">
						<div class="reference-image">
							<img
								src="/images/beats_arrangements.png"
								alt="Beats & Arrangements"
							/>
						</div>
						<div class="reference-content">
							<h3>Beats / Arrangements</h3>
							<p>Beatproduktionen von Rawlabs!</p>
							<ul class="actions">
								<li>
									<a
										href="/under-construction"
										class="button">Details</a
									>
								</li>
							</ul>
						</div>
					</div>
					<div class="reference-item">
						<div class="reference-image">
							<img src="/images/kuenstler.png" alt="Künstler" />
						</div>
						<div class="reference-content">
							<h3>Künstler</h3>
							<p>Künstler mit denen wir gearbeitet haben!</p>
							<ul class="actions">
								<li>
									<a
										href="/under-construction"
										class="button">Details</a
									>
								</li>
							</ul>
						</div>
					</div>
				</div>
				<ul class="actions special" style="margin-top: 3em;">
					<li>
						<a href="/under-construction" class="button"
							>Mehr Referenzen ansehen</a
						>
					</li>
				</ul>
			</div>
		</section>

		<!-- Three -->
		<section id="three" class="wrapper style3 fade-up">
			<div class="inner">
				<h2>Unsere Services</h2>
				<p>
					Wir helfen mit allem, was dein Song braucht, um auf die
					nächste Stufe zu kommen.<br /><br />Dein Sound, so wie du
					ihn dir vorstellst. <br />Dein Auftritt, so wie du als
					artist gesehen werden willst.
				</p>
				<div class="services-list">
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-sliders-h"></span>
						</div>
						<div class="service-details">
							<h3>Mixing</h3>
							<p>Professionelles Mixing von bis zu 15 Stems.</p>
							<a href="#contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-wave-square"
							></span>
						</div>
						<div class="service-details">
							<h3>Mastering</h3>
							<p>
								Professionelles Mastering um jeden Track radio
								ready zu machen.
							</p>
							<a href="#contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-drum"></span>
						</div>
						<div class="service-details">
							<h3>Beat Production</h3>
							<p>
								Individuelle Beat Produktion für Genres von Hip
								Hop, Rap, RnB bis hin zu Pop
							</p>
							<a href="#contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
					<div class="service-item">
						<div class="service-icon">
							<span class="icon solid major fa-palette"></span>
						</div>
						<div class="service-details">
							<h3>Assets</h3>
							<p>
								Von Album Artwork bis hin zu Social Media
								Graphics, wir kümmern uns darum
							</p>
							<a href="#contact" class="service-link"
								>Anfrage senden</a
							>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Packages -->
		<section id="packages" class="wrapper style3 fade-up">
			<div class="inner">
				<h2>Unsere Pakete</h2>
				<p>Wähle das passende Paket für dein Projekt.</p>
				<div class="pricing-grid">
					<!-- Essentials -->
					<div class="pricing-card">
						<h3>Essentials</h3>
						<ul class="pricing-features">
							<li>
								Beat Track <span class="detail"
									>(Stereo-Spur)</span
								>
							</li>
							<li>
								3 Vocal Stems <span class="detail"
									>(z.B. 1 Lead + 2 Doubles)</span
								>
							</li>
							<li>Standard Vocal Tuning, Leveling & Mixing</li>
							<li class="plus">Mastering Inklusive</li>
						</ul>
						<a
							href="#contact"
							class="button scrolly"
							data-package="essentials">Ab 30€</a
						>
					</div>

					<!-- Advanced -->
					<div class="pricing-card popular">
						<div class="popular-badge">Am beliebtesten!</div>
						<h3>Advanced</h3>
						<ul class="pricing-features">
							<li>
								Beat Track <span class="detail"
									>(Stereo-Spur)</span
								>
							</li>
							<li>
								7 Vocal Stems <span class="detail"
									>(z.B. 2 Leads, 4 Doubles, 1 Adlibs)</span
								>
							</li>
							<li>Standard Vocal Tuning, Leveling & Mixing</li>
							<li class="plus">Mastering Inklusive</li>
						</ul>
						<a
							href="#contact"
							class="button scrolly primary"
							data-package="advanced">Ab 60€</a
						>
					</div>

					<!-- Ultimate -->
					<div class="pricing-card">
						<h3>Ultimate</h3>
						<ul class="pricing-features">
							<li>
								Beat Track inkl. Mixing <span class="detail"
									>(Bis zu 18 Multitracks)</span
								>
							</li>
							<li>
								12 Vocal Stems <span class="detail"
									>(bis zu 12 Spuren)</span
								>
							</li>
							<li>Manuelle Pitch und Timing Correction</li>
							<li class="plus">Mastering Inklusive</li>
						</ul>
						<a
							href="#contact"
							class="button scrolly"
							data-package="ultimate">Ab 150€</a
						>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact -->
		<section id="contact" class="wrapper style1 fade-up">
			<div class="inner">
				<h2>Schreibe uns</h2>
				<p></p>
				<div class="split style1">
					<section>
						<form id="contact-form">
							<div class="fields">
								<div class="field">
									<label>Wähle dein Studio-Paket:</label>
									<div class="package-button-group">
										<button
											type="button"
											class="package-btn"
											data-value="Raw Labs Essentials"
											data-price="30"
											>Essentials (30€)</button
										>
										<button
											type="button"
											class="package-btn active"
											data-value="Raw Labs Advanced"
											data-price="60"
											>Advanced (60€)</button
										>
										<button
											type="button"
											class="package-btn"
											data-value="Raw Labs Ultimate"
											data-price="150"
											>Ultimate (150€)</button
										>
									</div>
									<input
										type="hidden"
										name="package"
										id="package-input"
										value="Raw Labs Advanced"
									/>
								</div>

								<div class="field half">
									<label for="name">Name</label>
									<input
										type="text"
										name="name"
										id="name"
										required
									/>
								</div>
								<div class="field half">
									<label for="email">Email</label>
									<input
										type="email"
										name="email"
										id="email"
										required
									/>
								</div>

								<!-- B2B Toggle -->
								<div class="field">
									<div class="checkbox-item">
										<input
											type="checkbox"
											id="is-b2b"
											name="is_b2b"
											class="addon-checkbox"
										/>
										<label for="is-b2b">Ich bestelle als Unternehmen (B2B)</label>
									</div>
								</div>

								<!-- B2B Fields (Conditional Wrapper with Grid slide animation) -->
								<div id="b2b-fields-wrapper">
									<div id="b2b-fields" style="border-left: 2px solid #a891ff; padding-left: 1.5em; overflow: hidden;">
										<div class="field" style="padding-top: 10px;">
											<label for="company_name">Firmenname *</label>
											<input
												type="text"
												name="company_name"
												id="company_name"
											/>
										</div>
										<div class="field" style="padding-bottom: 10px;">
											<label for="vat_number">USt-IdNr. (VAT ID) <span style="font-size:0.8em; opacity:0.7;">- Für steuerfreie EU-Lieferung</span></label>
											<input
												type="text"
												name="vat_number"
												id="vat_number"
												placeholder="z.B. DE123456789"
											/>
										</div>
									</div>
								</div>

								<!-- Address Toggle -->
								<div class="field">
									<div class="checkbox-item">
										<input
											type="checkbox"
											id="has-address"
											name="has_address"
											class="addon-checkbox"
										/>
										<label id="address-toggle-label" for="has-address">Rechnungsadresse angeben <span style="font-weight: normal; font-size: 0.85em; opacity: 0.6;">(erforderlich ab 250€)</span></label>
									</div>
								</div>

								<!-- Address Fields (Conditional Wrapper with Grid slide animation) -->
								<div id="address-fields-wrapper">
									<div id="address-fields" style="border-left: 2px solid #a891ff; padding-left: 1.5em; overflow: hidden;">
										<div class="field" style="padding-top: 10px;">
											<label for="street">Straße & Hausnummer *</label>
											<input
												type="text"
												name="street"
												id="street"
												placeholder="z.B. Hauptstraße 12"
											/>
										</div>
										<div class="field half">
											<label for="zip">PLZ *</label>
											<input
												type="text"
												name="zip"
												id="zip"
												placeholder="12345"
											/>
										</div>
										<div class="field half">
											<label for="city">Stadt *</label>
											<input
												type="text"
												name="city"
												id="city"
												placeholder="z.B. Berlin"
											/>
										</div>
										<div class="field" style="padding-bottom: 10px;">
											<label for="country">Land *</label>
											<select name="country" id="country">
												<option value="DE">Deutschland</option>
												<option value="AT">Österreich</option>
												<option value="CH">Schweiz</option>
												<option value="GB">Vereinigtes Königreich (UK)</option>
												<option value="US">Vereinigte Staaten (US)</option>
											</select>
										</div>
									</div>
								</div>

								<div class="field">
									<label for="message"
										>Gibt es noch etwas was wir wissen
										sollten?</label
									>
									<textarea
										name="message"
										id="message"
										rows="5"
										required></textarea>
								</div>

								<div class="field">
									<label
										>Zusätzliche Services (Add-ons):</label
									>
									<div class="checkbox-item">
										<input
											type="checkbox"
											id="addon-express"
											name="addons"
											value="Express Lieferung (48h)"
											data-price="20"
											class="addon-checkbox"
										/>
										<label
											id="express-label"
											for="addon-express"
											>Express-Lieferung (48h) (+20€)</label
										>
									</div>
								</div>

								<div class="field">
									<label
										id="songs-label"
										for="additional-songs"
										>Zusätzliche Songs (Mengenrabatt ab 2
										Songs):<br /><strong
											style="color: rgba(255,255,255,0.4)"
											>Keine</strong
										>
									</label>
									<div class="slider-wrapper">
										<input
											type="range"
											name="additional_songs"
											id="additional-songs"
											min="0"
											max="6"
											value="0"
											class="songs-slider"
										/>
									</div>
								</div>

								<div class="field">
									<div class="price-estimate-box">
										<div
											id="price-breakdown"
											class="price-breakdown"
										>
											<!-- Dynamically populated breakdown -->
										</div>
										<div
											class="price-row subtotal-row"
											id="subtotal-row"
											style="display:none;"
										>
											<span class="subtotal-label"
												>Zwischensumme</span
											>
											<span class="subtotal-amount"
												><span id="subtotal-price"
													>0</span
												>€</span
											>
										</div>
										<div
											class="price-row discount-row"
											id="discount-row"
										>
											<span class="discount-label"
												>Rabatt</span
											>
											<span class="discount-amount"
												>- <span id="discount-amount"
													>0</span
												>€</span
											>
										</div>
										<div class="price-row total-row">
											<span class="price-label"
												>Summe</span
											>
											<span class="price-amount"
												>~<span id="total-price">0</span
												>€</span
											>
										</div>
										<p class="price-disclaimer">
											Alle Preise inkl. MwSt.
										</p>
									</div>
								</div>

								<div class="field">
									<label for="song_demo"
										>Song Demo Anhängen (.mp3/.wav, Max.
										8MB)</label
									>
									<div class="file-upload-wrapper">
										<input
											type="file"
											name="song_demo"
											id="song_demo"
											accept=".mp3, .wav, audio/mpeg, audio/wav"
											class="hidden-file-input"
										/>
										<label
											for="song_demo"
											class="button primary icon solid fa-upload"
											>Datei auswählen</label
										>
										<span
											id="file-name-display"
											style="margin-left: 1em; opacity: 0.7; font-style: italic;"
											>Keine Datei ausgewählt</span
										>
									</div>
									<p
										style="font-size: 0.8em; margin-top: 1em; opacity: 0.7;"
									>
										Tipp: Für größere Dateien sende uns
										einfach einen Dropbox/WeTransfer Link in
										der Nachricht.
									</p>
								</div>

								<style>
									.pricing-grid {
										display: grid;
										grid-template-columns: repeat(3, 1fr);
										gap: 2em;
										margin-top: 2em;
										margin-bottom: 2em;
									}

									.pricing-card {
										background: rgba(255, 255, 255, 0.05);
										border: 1px solid
											rgba(255, 255, 255, 0.1);
										border-radius: 12px;
										padding: 2.5em 2em; /* Mehr padding für mehr "Breathing Room" */
										display: flex;
										flex-direction: column;
										position: relative;
										transition: transform 0.3s ease,
											border-color 0.3s ease,
											box-shadow 0.3s ease;
										box-sizing: border-box;
									}

									.pricing-card:hover {
										transform: translateY(-5px);
										border-color: rgba(255, 255, 255, 0.3);
										box-shadow: 0 10px 25px
											rgba(0, 0, 0, 0.2);
									}

									.pricing-card.popular {
										border-color: #a891ff; /* Accent color */
										background: linear-gradient(
											180deg,
											rgba(168, 145, 255, 0.1) 0%,
											rgba(168, 145, 255, 0.02) 100%
										);
										transform: scale(1.05);
										z-index: 1;
										padding: 3em 2.5em; /* Noch mehr Platz für die beliebte Karte */
										box-shadow: 0 0 30px
											rgba(168, 145, 255, 0.15);
									}

									.pricing-card.popular:hover {
										transform: scale(1.05) translateY(-5px);
										box-shadow: 0 15px 40px
											rgba(168, 145, 255, 0.25);
									}

									.popular-badge {
										position: absolute;
										top: -16px;
										left: 50%;
										transform: translateX(-50%);
										background: #a891ff;
										color: #fff;
										padding: 0.4em 1.5em;
										border-radius: 30px;
										font-size: 0.85em;
										font-weight: normal;
										letter-spacing: 0.05em;
										white-space: nowrap;
										box-shadow: 0 4px 15px
											rgba(168, 145, 255, 0.4);
									}

									.pricing-card h3 {
										margin-bottom: 1em;
										font-size: 1.6em;
										text-align: center;
										border-bottom: 1px solid
											rgba(255, 255, 255, 0.1);
										padding-bottom: 0.8em;
									}

									.pricing-card.popular h3 {
										color: #a891ff;
										font-size: 1.8em;
									}

									.pricing-card .pricing-features {
										list-style: none;
										padding: 0;
										margin: 0 0 2em 0;
										flex-grow: 1;
									}

									.pricing-card .pricing-features li {
										padding: 0.5em 0; /* Etwas kompakter, da keine Linien mehr trennen */
										border-bottom: none;
										font-size: 0.85em;
										line-height: 1.5;
										text-align: center; /* Zentrierte Liste sieht oft eleganter aus in Preistabellen */
									}

									.pricing-card .pricing-features li.plus {
										font-weight: normal;
										color: #a891ff;
									}

									.pricing-card .pricing-features .detail {
										display: block;
										font-size: 0.75em;
										margin-top: 0.3em;
										opacity: 0.8;
									}

									.pricing-card .button {
										width: 100%;
										text-align: center;
										margin-top: auto;
									}

									@media screen and (max-width: 980px) {
										.pricing-grid {
											grid-template-columns: 1fr;
											max-width: 500px;
											margin-left: auto;
											margin-right: auto;
										}

										.pricing-card.popular {
											transform: none;
										}

										.pricing-card.popular:hover {
											transform: translateY(-5px);
										}
									}

									#sidebar .inner {
										padding-top: 2em; /* Balanced top padding */
									}

									.sidebar-logo-link {
										display: flex !important;
										justify-content: center;
										align-items: center;
										border-bottom: none !important;
										margin-bottom: 2em;
									}

									.sidebar-logo {
										max-width: 150px;
										height: auto;
										display: block;
										margin: 0 !important;
										transition: all 0.3s ease;
									}

									@media screen and (max-width: 1280px) {
										#sidebar .inner {
											padding-top: 0;
											display: flex;
											align-items: center;
											justify-content: space-between;
											padding-right: 1.5em; /* Match left padding */
										}

										.sidebar-logo-link {
											margin-bottom: 0;
											justify-content: flex-start;
											padding-left: 1.5em;
										}

										.sidebar-logo {
											max-width: 40px;
										}
									}

									.hidden-file-input {
										width: 0.1px;
										height: 0.1px;
										opacity: 0;
