---
import logo from '../assets/rawlabs logo.png';
---
<!DOCTYPE HTML>
<html>
	<head>
		<title>Beats & Arrangements - Rawlabs Studios</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="stylesheet" href="/assets/css/main.css" />
		<noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
	</head>
	<body class="is-preload">

		<!-- Header -->
			<header id="header">
				<a href="/" class="title" style="border-bottom: none;"><img src={logo.src} alt="Rawlabs Logo" style="height: 2.5em; vertical-align: middle;" /></a>
				<nav>
					<ul>
						<li><a href="/" class="button small icon solid fa-chevron-left">Zurück zum Studio</a></li>
					</ul>
				</nav>
			</header>

		<!-- Wrapper -->
			<div id="wrapper">

				<!-- Main -->
					<section id="main" class="wrapper">
						<div class="inner">
							<h1 class="major">Beats & Arrangements Referenzen</h1>
							<p>Hier siehst du eine Auswahl unserer Beat-Produktionen und Song-Arrangements. Jeder Beat wird exklusiv für dich komponiert und arrangiert.</p>
							
							<div class="references-grid">
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/album_art.png" alt="Midnight City Beat" />
									</div>
									<div class="reference-content">
										<h3>Midnight City</h3>
										<p>Trap/RnB Instrumental. Düstere, sphärische Keys gepaart mit tiefen 808-Slides und anspruchsvollen Hi-Hat Roll-Mustern.</p>
									</div>
								</div>
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/album_art.png" alt="Sunset Boulevard Beat" />
									</div>
									<div class="reference-content">
										<h3>Sunset Boulevard</h3>
										<p>Chill/Lofi RnB Instrumental. Warme E-Piano Chords, sanfter Vintage-Drum-Groove und ein einprägsamer Lead-Synthesizer.</p>
									</div>
								</div>
								<div class="reference-item">
									<div class="reference-image">
										<img src="/images/album_art.png" alt="Cyberpunk Anthem Beat" />
									</div>
									<div class="reference-content">
										<h3>Cyberpunk Anthem</h3>
										<p>Synthwave/Future Bass Instrumental. Treibende Drums, energiegeladene Retro-Arpeggios und epische Brass-Akkorde für maximale Dynamik.</p>
									</div>
								</div>
							</div>
						</div>
					</section>

			</div>

		<!-- Footer -->
			<footer id="footer" class="wrapper alt">
				<div class="inner">
					<ul class="menu">
						<li>&copy; Rawlabs Studios. Alle Rechte vorbehalten.</li>
						<li><a href="/impressum">Impressum</a></li>
					</ul>
				</div>
			</footer>

		<!-- Scripts -->
			<script is:inline src="/assets/js/jquery.min.js"></script>
			<script is:inline src="/assets/js/jquery.scrollex.min.js"></script>
			<script is:inline src="/assets/js/jquery.scrolly.min.js"></script>
			<script is:inline src="/assets/js/browser.min.js"></script>
			<script is:inline src="/assets/js/breakpoints.min.js"></script>
			<script is:inline src="/assets/js/util.js"></script>
			<script is:inline src="/assets/js/main.js"></script>

	</body>
</html>
