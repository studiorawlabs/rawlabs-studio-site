			<script is:inline src="/assets/js/jquery.scrolly.min.js"></script>
			<script is:inline src="/assets/js/browser.min.js"></script>
			<script is:inline src="/assets/js/breakpoints.min.js"></script>
			<script is:inline src="/assets/js/util.js"></script>
			<script is:inline src="/assets/js/main.js"></script>

			<script is:inline>
			(function() {
				// ===== Generate waveform bars =====
				document.querySelectorAll('.waveform').forEach(function(wf) {
					for (var i = 0; i < 30; i++) {
						var bar = document.createElement('div');
						bar.className = 'wave-bar';
						bar.style.setProperty('--wave-duration', (0.4 + Math.random() * 0.6) + 's');
						bar.style.animationDelay = (Math.random() * 0.5) + 's';
						wf.appendChild(bar);
					}
				});

				var currentAudio = null;
				var currentCard = null;

				// ===== Format time =====
				function formatTime(sec) {
					if (isNaN(sec) || !isFinite(sec)) return '0:00';
					var m = Math.floor(sec / 60);
					var s = Math.floor(sec % 60);
					return m + ':' + (s < 10 ? '0' : '') + s;
				}

				// ===== Stop current =====
				function stopCurrent() {
					if (currentAudio) {
						currentAudio.pause();
						currentAudio.currentTime = 0;
					}
					if (currentCard) {
						currentCard.classList.remove('playing');
						var icon = currentCard.querySelector('.play-btn i');
						icon.className = 'fas fa-play';
						var fill = currentCard.querySelector('.progress-fill');
						fill.style.width = '0%';
						var ct = currentCard.querySelector('.current-time');
						ct.textContent = '0:00';
					}
					currentAudio = null;
					currentCard = null;
				}

				// ===== Initialize each card =====
				document.querySelectorAll('.beat-card').forEach(function(card) {
					var audio = card.querySelector('audio');
					var btn = card.querySelector('.play-btn');
					var icon = btn.querySelector('i');
					var progressWrap = card.querySelector('.progress-wrap');
					var progressFill = card.querySelector('.progress-fill');
					var currentTimeEl = card.querySelector('.current-time');
					var durationEl = card.querySelector('.duration');

					// Set duration when metadata loads
					audio.addEventListener('loadedmetadata', function() {
						durationEl.textContent = formatTime(audio.duration);
					});

					// Update progress
					audio.addEventListener('timeupdate', function() {
						if (audio.duration) {
							var pct = (audio.currentTime / audio.duration) * 100;
							progressFill.style.width = pct + '%';
							currentTimeEl.textContent = formatTime(audio.currentTime);
						}
					});

					// When audio ends
					audio.addEventListener('ended', function() {
						card.classList.remove('playing');
						icon.className = 'fas fa-play';
						progressFill.style.width = '0%';
						currentTimeEl.textContent = '0:00';
						audio.currentTime = 0;
						if (currentCard === card) {
							currentAudio = null;
							currentCard = null;
						}
					});

					// Play/Pause toggle
					btn.addEventListener('click', function() {
						if (currentAudio && currentAudio !== audio) {
							stopCurrent();
						}
						if (audio.paused) {
							audio.play();
							card.classList.add('playing');
							icon.className = 'fas fa-pause';
							currentAudio = audio;
							currentCard = card;
						} else {
							audio.pause();
							card.classList.remove('playing');
							icon.className = 'fas fa-play';
						}
					});

					// Seek on click
					progressWrap.addEventListener('click', function(e) {
						if (audio.duration) {
							var rect = progressWrap.getBoundingClientRect();
							var x = e.clientX - rect.left;
							var pct = x / rect.width;
							audio.currentTime = pct * audio.duration;
							if (audio.paused) {
								if (currentAudio && currentAudio !== audio) {
									stopCurrent();
								}
								audio.play();
								card.classList.add('playing');
								icon.className = 'fas fa-pause';
								currentAudio = audio;
								currentCard = card;
							}
						}
					});
				});

				// ===== Genre Filtering with FLIP layout transitions =====
				var filterBtns = document.querySelectorAll('.genre-btn');
				var cards = document.querySelectorAll('.beat-card');
				var noResults = document.getElementById('noResults');
				var grid = document.getElementById('beatsGrid');

				filterBtns.forEach(function(btn) {
					btn.addEventListener('click', function() {
						// Update active button
						filterBtns.forEach(function(b) { b.classList.remove('active'); });
						btn.classList.add('active');

						var genre = btn.getAttribute('data-genre');

						// 1. First: Record positions of cards and grid height
						var firstRects = [];
						cards.forEach(function(card, idx) {
							firstRects[idx] = card.getBoundingClientRect();
						});
						var gridFirstHeight = grid.offsetHeight;

						// 2. Last: Apply class changes immediately (synchronously)
						var visibleCount = 0;
						cards.forEach(function(card) {
							var cardGenres = card.getAttribute('data-genres');
							if (!cardGenres) return;
							
							var isMatch = (genre === 'all' || cardGenres.split(',').indexOf(genre) !== -1);
							if (isMatch) {
								card.classList.remove('hidden');
								card.style.opacity = '1';
								card.style.transform = 'none';
								visibleCount++;
							} else {
								card.classList.add('hidden');
								if (currentCard === card) {
									stopCurrent();
								}
							}
						});

						// Show/hide no results
						if (visibleCount === 0) {
							noResults.classList.add('visible');
						} else {
							noResults.classList.remove('visible');
						}

						// Record final grid height
						grid.style.transition = 'none';
						var gridLastHeight = grid.offsetHeight;
						
						// Set grid height back to first height
						grid.style.height = gridFirstHeight + 'px';
						grid.offsetHeight; // force reflow
						
						// Transition grid height to final height
						grid.style.transition = 'height 0.45s cubic-bezier(0.25, 0.8, 0.25, 1)';
						grid.style.height = gridLastHeight + 'px';

						// 3. Invert: Translate cards back to first position
						cards.forEach(function(card, idx) {
							if (card.classList.contains('hidden')) return;

							var first = firstRects[idx];
							var last = card.getBoundingClientRect();
							
							var deltaX = first.left - last.left;
							var deltaY = first.top - last.top;

							if (deltaX !== 0 || deltaY !== 0) {
								card.style.transition = 'none';
								card.style.transform = 'translate3d(' + deltaX + 'px, ' + deltaY + 'px, 0)';
								card.offsetHeight; // force reflow
							}
						});

						// 4. Play: Transition cards to final position
						requestAnimationFrame(function() {
							cards.forEach(function(card) {
								if (card.classList.contains('hidden')) return;
								card.style.transition = 'transform 0.45s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.45s cubic-bezier(0.25, 0.8, 0.25, 1)';
								card.style.transform = 'none';
							});
						});

						// Reset temporary height styles after transition finishes
						setTimeout(function() {
							grid.style.height = '';
							grid.style.transition = '';
						}, 450);
					});
				});
			})();
			</script>

	</body>
</html>
