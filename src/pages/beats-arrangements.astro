---
import logo from '../assets/rawlabs logo.png';
import PageTransition from '../components/PageTransition.astro';
---
<!DOCTYPE HTML>
<html>
	<head>
		<title>Beats & Arrangements - Rawlabs Studios</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
		<meta name="description" content="Entdecke unsere Beat-Produktionen und Song-Arrangements. Trap, Future Bass, Hyperpop und mehr – exklusiv produziert von Rawlabs Studios." />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="stylesheet" href="/assets/css/main.css" />
		<noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
		<style>
			body, #wrapper, #main, section.wrapper {
				background: radial-gradient(circle at 50% 0%, #190f33 0%, #0c0818 100%) !important;
				color: #e2dcf0 !important;
			}
			#main.wrapper {
				background: transparent !important;
				padding: 3em 0 6em 0 !important;
			}

			/* ===== Genre Filter ===== */
			.genre-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				justify-content: center;
				margin-bottom: 2.5em;
			}
			.genre-btn {
				padding: 0.5em 1.4em !important;
				border-radius: 50px !important;
				border: 1px solid rgba(255,255,255,0.2) !important;
				background: transparent !important;
				color: rgba(255,255,255,0.7) !important;
				font-size: 0.85em !important;
				cursor: pointer !important;
				transition: all 0.3s ease !important;
				font-family: inherit !important;
				letter-spacing: 0.03em !important;
				display: inline-flex !important;
				align-items: center !important;
				justify-content: center !important;
				text-align: center !important;
				line-height: 1 !important;
				height: auto !important;
			}
			.genre-btn:hover {
				border-color: rgba(168, 145, 255, 0.4);
				color: #fff;
				transform: translateY(-1px);
			}
			.genre-btn.active {
				background: #a891ff;
				border-color: transparent;
				color: #fff;
				box-shadow: 0 4px 15px rgba(168,145,255,0.4);
			}

			/* ===== Beat Grid ===== */
			.beats-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
			}
			@media screen and (max-width: 980px) {
				.beats-grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media screen and (max-width: 600px) {
				.beats-grid { grid-template-columns: 1fr; }
			}

			/* ===== Beat Card ===== */
			.beat-card {
				background: rgba(255,255,255,0.02) !important;
				backdrop-filter: blur(12px) !important;
				-webkit-backdrop-filter: blur(12px) !important;
				border: 1px solid rgba(168, 145, 255, 0.1) !important;
				border-radius: 16px;
				padding: 1.5em;
				transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
				position: relative;
				overflow: hidden;
				opacity: 1;
			}
			.beat-card::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				border-radius: 16px;
				padding: 1px;
				background: linear-gradient(135deg, rgba(168,145,255,0), rgba(203,178,255,0));
				-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
				-webkit-mask-composite: xor;
				mask-composite: exclude;
				transition: background 0.4s ease;
				pointer-events: none;
			}
			.beat-card:hover {
				transform: translateY(-4px) scale(1.015);
				background: rgba(255,255,255,0.04) !important;
				border-color: rgba(168,145,255,0.25) !important;
				box-shadow: 0 8px 32px rgba(168,145,255,0.15);
			}
			.beat-card:hover::before {
				background: linear-gradient(135deg, rgba(168,145,255,0.3), rgba(203,178,255,0.3));
			}
			.beat-card.playing {
				border-color: rgba(168,145,255,0.4) !important;
				animation: cardGlow 2s ease-in-out infinite;
			}
			@keyframes cardGlow {
				0%, 100% { box-shadow: 0 0 15px rgba(168,145,255,0.2), 0 0 30px rgba(203,178,255,0.1); }
				50% { box-shadow: 0 0 25px rgba(168,145,255,0.35), 0 0 50px rgba(203,178,255,0.2); }
			}

			/* Hide filtered cards */
			.beat-card.hidden {
				display: none;
			}

			/* ===== Card Header ===== */
			.beat-title {
				font-size: 1.15em;
				color: #fff;
				margin-bottom: 0.6em;
				font-weight: 600;
			}
			.beat-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-bottom: 1.2em;
			}
			.tag {
				display: inline-block;
				padding: 0.25em 0.8em;
				border-radius: 50px;
				font-size: 0.7em;
				letter-spacing: 0.03em;
				font-weight: 500;
				background: rgba(168, 145, 255, 0.07) !important;
				color: #cbb2ff !important;
				border: 1px solid rgba(168, 145, 255, 0.15) !important;
			}

			/* ===== Custom Audio Player ===== */
			.player {
				display: flex;
				align-items: center;
				gap: 0.8em;
			}
			.play-btn {
				width: 44px !important;
				height: 44px !important;
				min-width: 44px !important;
				border-radius: 50% !important;
				border: none !important;
				background: #a891ff !important;
				color: #fff !important;
				font-size: 0.9em !important;
				cursor: pointer !important;
				display: inline-flex !important;
				align-items: center !important;
				justify-content: center !important;
				transition: all 0.25s ease !important;
				box-shadow: 0 2px 12px rgba(168, 145, 255, 0.45) !important;
				padding: 0 !important;
				line-height: 1 !important;
				text-align: center !important;
			}
			.play-btn:hover {
				transform: scale(1.1) !important;
				box-shadow: 0 4px 18px rgba(168, 145, 255, 0.7) !important;
				background: #b8a5ff !important;
			}
			.play-btn i {
				display: inline-flex !important;
				align-items: center !important;
				justify-content: center !important;
				margin: 0 !important;
				padding: 0 !important;
				line-height: 1 !important;
				width: auto !important;
				height: auto !important;
			}
			.play-btn .fa-play {
				padding-left: 2px !important;
			}
			.player-body {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.3em;
				min-width: 0;
			}

			/* ===== Progress Bar ===== */
			.progress-wrap {
				position: relative;
				width: 100%;
				height: 6px;
				background: rgba(255,255,255,0.08);
				border-radius: 3px;
				cursor: pointer;
				overflow: hidden;
			}
			.progress-fill {
				height: 100%;
				width: 0%;
				background: linear-gradient(90deg, #a891ff, #cbb2ff);
				border-radius: 3px;
				transition: width 0.1s linear;
				position: relative;
				z-index: 2;
			}

			/* ===== Waveform Visualizer ===== */
			.waveform {
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				display: flex;
				align-items: flex-end;
				gap: 2px;
				padding: 0 1px;
				opacity: 0;
				transition: opacity 0.3s ease;
				z-index: 1;
			}
			.beat-card.playing .waveform {
				opacity: 0.4;
			}
			.wave-bar {
				flex: 1;
				background: rgba(168,145,255,0.4);
				border-radius: 1px;
				animation: waveAnim var(--wave-duration, 0.8s) ease-in-out infinite alternate;
			}
			@keyframes waveAnim {
				0% { height: 15%; }
				100% { height: 100%; }
			}

			/* ===== Time Display ===== */
			.time-display {
				display: flex;
				justify-content: space-between;
				font-size: 0.65em;
				color: rgba(255,255,255,0.4);
				font-variant-numeric: tabular-nums;
			}

			/* ===== Intro section ===== */
			.beats-intro {
				text-align: center;
				margin-bottom: 1em;
			}
			.beats-intro p {
				max-width: 700px;
				margin: 0 auto 2em;
				color: rgba(255,255,255,0.55);
			}

			/* ===== No results ===== */
			.no-results {
				grid-column: 1 / -1;
				text-align: center;
				padding: 3em 1em;
				color: rgba(255,255,255,0.35);
				font-size: 1.1em;
				display: none;
			}
			.no-results.visible {
				display: block;
			}
		</style>
	</head>
