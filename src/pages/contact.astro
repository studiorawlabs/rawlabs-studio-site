		<script is:inline>
			(function () {
				// State Management
				let currentStep = 1;
				let currentTotal = 0;
				let prevTotal = 0;
				let prevSubtotal = 0;
				let prevDiscount = 0;

				function animateValue(
					element,
					start,
					end,
					duration = 350,
					suffix = "",
				) {
					if (!element) return;
					const startVal = parseInt(start) || 0;
					const endVal = parseInt(end) || 0;
					if (startVal === endVal) {
						element.innerText = endVal + suffix;
						return;
					}
					if (element.dataset.animId) {
						cancelAnimationFrame(parseInt(element.dataset.animId));
					}
					const startTime = performance.now();
					function update(now) {
						const elapsed = now - startTime;
						const progress = Math.min(elapsed / duration, 1);
						const easeProgress = 1 - Math.pow(1 - progress, 4); // Snappy quartic ease out
						const current = Math.round(
							startVal + (endVal - startVal) * easeProgress,
						);
						element.innerText = current + suffix;
						if (progress < 1) {
							element.dataset.animId =
								requestAnimationFrame(update);
						} else {
							delete element.dataset.animId;
						}
					}
					element.dataset.animId = requestAnimationFrame(update);
				}

				let sliderSnapAnimFrame = null;

				let lastVisualVal = null;

				function updateVisualSlider(force = false) {
					try {
						if (!songsSlider || !customFill || !customThumb) {
							return;
						}
						const min = parseFloat(songsSlider.min) || 0;
						const max = parseFloat(songsSlider.max) || 6;
						const val = parseFloat(songsSlider.value);

						// Snapping behavior while dragging: map visual thumb to the rounded integer target!
						const visualVal = Math.round(val);

						if (visualVal === lastVisualVal && !force) {
							return;
						}
						lastVisualVal = visualVal;

						const visualRatio = (visualVal - min) / (max - min);

						// Pre-calculate percentage and offset in pixels to keep layout 100% browser-safe
						const pct = visualRatio * 100;
						const offset = 11 - 22 * visualRatio;

						const cssValue = `calc(${pct}% + ${offset}px)`;
						customFill.style.width = cssValue;
						customThumb.style.left = cssValue;
					} catch (err) {
						console.error("Error in updateVisualSlider:", err);
					}
				}

				function snapSliderToInteger() {
					if (!songsSlider) return;
					const val = parseFloat(songsSlider.value);
					const target = Math.round(val);
					if (val === target) return;

					if (sliderSnapAnimFrame) {
						cancelAnimationFrame(sliderSnapAnimFrame);
					}

					const startVal = val;
					const startTime = performance.now();
					const duration = 250; // Snappy 250ms snap animation

					function step(now) {
						const elapsed = now - startTime;
						const progress = Math.min(elapsed / duration, 1);

						const ease = 1 - Math.pow(1 - progress, 3); // Snappy cubic ease out
						const current = startVal + (target - startVal) * ease;
						songsSlider.value = current;

						updateVisualSlider();
						updateSongsLabel();
						updateTotal();

						if (progress < 1) {
							sliderSnapAnimFrame = requestAnimationFrame(step);
						} else {
							songsSlider.value = target;
							updateVisualSlider();
							updateSongsLabel();
							updateTotal();
						}
					}
					sliderSnapAnimFrame = requestAnimationFrame(step);
				}

				// DOM Elements
				const form = document.getElementById("contact-form");
				const steps = document.querySelectorAll(".wizard-step");
				const progressbarItems =
					document.querySelectorAll("#progressbar li");
				const prevBtn = document.getElementById("prev-btn");
				const nextBtn = document.getElementById("next-btn");
				const submitBtn = document.getElementById("submit-btn");
				const formStatus = document.getElementById("form-status");
				const loadingWrapper =
					document.getElementById("loading-wrapper");

				const packageInput = document.getElementById("package-input");
				const packageBtns = document.querySelectorAll(".package-btn");
				const songsSlider = document.getElementById("additional-songs");
				const customFill = document.getElementById("custom-fill");
				const customThumb = document.getElementById("custom-thumb");
				const songsLabel = document.getElementById("songs-label");
				const expressCheckbox =
					document.getElementById("addon-express");
				const expressLabel = document.getElementById("express-label");

				const fileInput = document.getElementById("song_demo");
				const fileDisplay =
					document.getElementById("file-name-display");

				const isB2bCheckbox = document.getElementById("is-b2b");
				const b2bWrapper = document.getElementById("b2b-wrapper");
				const companyInput = document.getElementById("company_name");
				const vatInput = document.getElementById("vat_number");

				const hasAddressCheckbox =
					document.getElementById("has-address");
				const addressWrapper =
					document.getElementById("address-wrapper");
				const streetInput = document.getElementById("street");
				const zipInput = document.getElementById("zip");
				const cityInput = document.getElementById("city");
				const countryInput = document.getElementById("country");
				const addressToggleLabel = document.getElementById(
					"address-toggle-label",
				);

				const priceBreakdown =
					document.getElementById("price-breakdown");
				const breakdownPkgRow =
					document.getElementById("breakdown-package");
				const qtyPkgDisplay = document.getElementById("qty-pkg");
				const namePkgDisplay = document.getElementById("name-pkg");
				const pricePkgDisplay = document.getElementById("price-pkg");

				const breakdownExpressRow =
					document.getElementById("breakdown-express");
				const qtyExpressDisplay =
					document.getElementById("qty-express");
				const priceExpressDisplay =
					document.getElementById("price-express");

				const subtotalRow = document.getElementById("subtotal-row");
				const subtotalPriceDisplay =
					document.getElementById("subtotal-price");
				const discountRow = document.getElementById("discount-row");
				const discountAmountDisplay =
					document.getElementById("discount-amount");
				const totalPriceDisplay =
					document.getElementById("total-price");

				// Init token
				document.getElementById("form-token").value = Date.now();

				// Step 1: Pre-select package from URL parameter
				const urlParams = new URLSearchParams(window.location.search);
				const packageParam = urlParams.get("package");
				if (packageParam) {
					const cleanParam = packageParam.toLowerCase();
					let matchedBtn = null;
					packageBtns.forEach((btn) => {
						const val = btn.dataset.value.toLowerCase();
						if (val.includes(cleanParam)) {
							matchedBtn = btn;
						}
					});
					if (matchedBtn) {
						packageBtns.forEach((b) =>
							b.classList.remove("active"),
						);
						matchedBtn.classList.add("active");
						packageInput.value = matchedBtn.dataset.value;
					}
				}

				// Event Listeners: Packages
				packageBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						packageBtns.forEach((b) =>
							b.classList.remove("active"),
						);
						btn.classList.add("active");
						packageInput.value = btn.dataset.value;
						updateTotal();
					});
				});

				// Event Listeners: Songs Slider
				songsSlider.addEventListener("input", () => {
					if (sliderSnapAnimFrame) {
						cancelAnimationFrame(sliderSnapAnimFrame);
					}
					updateVisualSlider();
					updateSongsLabel();
					updateTotal();
				});

				songsSlider.addEventListener("change", snapSliderToInteger);
				songsSlider.addEventListener("mouseup", snapSliderToInteger);
				songsSlider.addEventListener("touchend", snapSliderToInteger);

				// Event Listeners: Express Addon
				expressCheckbox.addEventListener("change", () => {
					updateTotal();
				});

				// Multi-File Input: Accumulate files across selections
				let accumulatedFiles = [];
				const fileListContainer = document.getElementById("file-list");

				function formatFileSize(bytes) {
					if (bytes < 1024) return bytes + " B";
					if (bytes < 1024 * 1024)
						return (bytes / 1024).toFixed(1) + " KB";
					return (bytes / (1024 * 1024)).toFixed(1) + " MB";
				}

				function renderFileList() {
					fileListContainer.innerHTML = "";
					if (accumulatedFiles.length === 0) {
						fileDisplay.innerText = "Keine Dateien ausgewählt";
						return;
					}
					fileDisplay.innerText =
						accumulatedFiles.length +
						(accumulatedFiles.length === 1
							? " Datei"
							: " Dateien") +
						" ausgewählt";
					accumulatedFiles.forEach((file, idx) => {
						const item = document.createElement("div");
						item.className = "file-list-item";
						item.innerHTML = `
								<span class="file-icon">🎵</span>
								<span class="file-name">${file.name}</span>
								<span class="file-size">${formatFileSize(file.size)}</span>
								<button type="button" class="file-remove" data-idx="${idx}" title="Entfernen">✕</button>
							`;
						item.querySelector(".file-remove").addEventListener(
							"click",
							(e) => {
								const removeIdx = parseInt(
									e.currentTarget.dataset.idx,
								);
								accumulatedFiles.splice(removeIdx, 1);
								renderFileList();
							},
						);
						fileListContainer.appendChild(item);
					});
				}

				fileInput.addEventListener("change", () => {
					const newFiles = Array.from(fileInput.files);
					const maxSizeBytes = 8 * 1024 * 1024; // 8MB
					const rejectedFiles = [];
					const fileErrorMsg = document.getElementById("file-error-message");

					if (fileErrorMsg) {
						fileErrorMsg.style.display = "none";
						fileErrorMsg.innerText = "";
					}

					newFiles.forEach((f) => {
						if (f.size > maxSizeBytes) {
							rejectedFiles.push(f.name);
							return;
						}
						// Avoid duplicates by name+size
						if (
							!accumulatedFiles.some(
								(existing) =>
									existing.name === f.name &&
									existing.size === f.size,
							)
						) {
							accumulatedFiles.push(f);
						}
					});

					if (rejectedFiles.length > 0 && fileErrorMsg) {
						fileErrorMsg.innerText = rejectedFiles.length === 1
							? `Die Datei "${rejectedFiles[0]}" überschreitet das Limit von 8MB und wurde nicht hinzugefügt.`
							: `Folgende Dateien überschreiten das Limit von 8MB und wurden nicht hinzugefügt: ${rejectedFiles.join(", ")}`;
						fileErrorMsg.style.display = "block";
					}

					renderFileList();
					// Reset native input so the same file(s) can be re-selected
					fileInput.value = "";
				});

				// B2B Collapse
				isB2bCheckbox.addEventListener("change", () => {
					if (isB2bCheckbox.checked) {
						b2bWrapper.classList.add("open");
						companyInput.required = true;
					} else {
						b2bWrapper.classList.remove("open");
						companyInput.required = false;
						companyInput.value = "";
						vatInput.value = "";
					}
				});

				// Address Collapse
				hasAddressCheckbox.addEventListener("change", () => {
					if (hasAddressCheckbox.checked) {
						addressWrapper.classList.add("open");
						streetInput.required = true;
						zipInput.required = true;
						cityInput.required = true;
					} else {
						addressWrapper.classList.remove("open");
						streetInput.required = false;
						zipInput.required = false;
						cityInput.required = false;
						streetInput.value = "";
						zipInput.value = "";
						cityInput.value = "";
						countryInput.value = "DE";
					}
				});

				// Main Pricing Math matching index.astro exactly
				function updateTotal() {
					let total = 0;
					let packagePrice = 0;
					let packageName = "Studio Paket";

					const activePkgBtn = document.querySelector(
						".package-btn.active",
					);
					if (activePkgBtn) {
						packagePrice = parseInt(
							activePkgBtn.dataset.price || 0,
						);
						packageName =
							activePkgBtn.querySelector("h3").innerText;
					}

					const additionalSongsCount = Math.round(
						parseFloat(songsSlider.value || 0),
					);
					const totalSongs = 1 + additionalSongsCount;
					const songsSubtotal = packagePrice * totalSongs;
					let addonsSubtotal = 0;

					// Update Package Row
					qtyPkgDisplay.innerText = totalSongs + "x";
					namePkgDisplay.innerText = packageName;

					const currentPkgPrice =
						parseInt(pricePkgDisplay.innerText) || 0;
					animateValue(
						pricePkgDisplay,
						currentPkgPrice,
						songsSubtotal,
						400,
						"€",
					);

					// Express delivery scales with total number of songs
					const expressBasePrice = parseInt(
						expressCheckbox.dataset.price || 20,
					);
					const expressTotal = expressBasePrice * totalSongs;

					if (expressCheckbox.checked) {
						addonsSubtotal += expressTotal;
						qtyExpressDisplay.innerText = totalSongs + "x";

						const currentExpressPrice =
							parseInt(priceExpressDisplay.innerText) || 0;
						animateValue(
							priceExpressDisplay,
							currentExpressPrice,
							expressTotal,
							400,
							"€",
						);

						breakdownExpressRow.classList.add("show");
					} else {
						breakdownExpressRow.classList.remove("show");
					}

					// Tiered discount on songs subtotal
					let discountPct = 0;
					if (totalSongs >= 5) discountPct = 0.2;
					else if (totalSongs >= 3) discountPct = 0.15;
					else if (totalSongs === 2) discountPct = 0.05;

					const preDiscountSubtotal = songsSubtotal + addonsSubtotal;
					let discountValue = 0;
					if (discountPct > 0) {
						discountValue = Math.round(songsSubtotal * discountPct);
					}

					total = preDiscountSubtotal - discountValue;
					currentTotal = total;

					// Update Displays with Counting Up Animation
					animateValue(totalPriceDisplay, prevTotal, total, 400);
					prevTotal = total;

					if (discountValue > 0) {
						discountRow.classList.add("show");
						animateValue(
							discountAmountDisplay,
							prevDiscount,
							discountValue,
							400,
						);
						prevDiscount = discountValue;

						subtotalRow.classList.add("show");
						animateValue(
							subtotalPriceDisplay,
							prevSubtotal,
							preDiscountSubtotal,
							400,
						);
						prevSubtotal = preDiscountSubtotal;
					} else {
						discountRow.classList.remove("show");
						animateValue(
							discountAmountDisplay,
							prevDiscount,
							0,
							400,
						);
						prevDiscount = 0;

						subtotalRow.classList.remove("show");
						animateValue(
							subtotalPriceDisplay,
							prevSubtotal,
							0,
							400,
						);
						prevSubtotal = 0;
					}

					// Address requirements enforcement for >= 250€
					if (total >= 250) {
						hasAddressCheckbox.checked = true;
						hasAddressCheckbox.disabled = true;
						addressWrapper.classList.add("open");
						streetInput.required = true;
						zipInput.required = true;
						cityInput.required = true;
						addressToggleLabel.innerHTML = `Rechnungsadresse angeben <span style="font-weight: normal; font-size: 0.85em; color: #f44336;">(Erforderlich, da über 250€)</span>`;
					} else {
						hasAddressCheckbox.disabled = false;
						addressToggleLabel.innerHTML = `Rechnungsadresse angeben <span style="font-weight: normal; font-size: 0.85em; opacity: 0.6;">(erforderlich ab 250€)</span>`;
						if (!hasAddressCheckbox.checked) {
							addressWrapper.classList.remove("open");
							streetInput.required = false;
							zipInput.required = false;
							cityInput.required = false;
						}
					}
				}

				function updateSongsLabel() {
					const count = Math.round(
						parseFloat(songsSlider.value || 0),
					);
					if (count === 0) {
						songsLabel.innerHTML = `Zusätzliche Songs (Mengenrabatt ab 2 Songs):<br><span style="font-weight: normal; color: rgba(255,255,255,0.4)">Keine</span>`;
					} else {
						const totalSongs = 1 + count;
						let discountStr = "";
						if (totalSongs >= 5) discountStr = "20%";
						else if (totalSongs >= 3) discountStr = "15%";
						else if (totalSongs === 2) discountStr = "5%";

						const text =
							count === 1
								? "1 zusätzlicher Song"
								: `${count} zusätzliche Songs`;
						songsLabel.innerHTML = `Zusätzliche Songs (Mengenrabatt ab 2 Songs):<br><span style="display: inline-block; color: #a891ff; font-weight: normal;">${text} (-${discountStr})</span>`;
					}

					// Scale Express price label description
					const expressBasePrice = parseInt(
						expressCheckbox.dataset.price || 20,
					);
					const expressTotal = expressBasePrice * (1 + count);
					expressLabel.innerHTML = `Express-Lieferung (48h) (+${expressTotal}€)`;
				}

				// Form Stepper Logic
				function showStep(stepNum) {
					steps.forEach((step) => step.classList.remove("active"));
					document
						.querySelector(`.wizard-step[data-step="${stepNum}"]`)
						.classList.add("active");

					progressbarItems.forEach((item, idx) => {
						item.classList.remove("active", "completed");
						const s = idx + 1;
						if (s === stepNum) item.classList.add("active");
						else if (s < stepNum) item.classList.add("completed");
					});

					currentStep = stepNum;

					// Button visibilities
					prevBtn.style.display =
						stepNum === 1 ? "none" : "inline-block";
					if (stepNum === 4) {
						nextBtn.style.display = "none";
						submitBtn.style.display = "inline-block";
						buildSummary();
						// Hide the Projektübersicht box on the summary step to avoid duplication
						document.querySelector(
							".price-estimate-box",
						).classList.add("hidden");
					} else {
						nextBtn.style.display = "inline-block";
						submitBtn.style.display = "none";
						document.querySelector(
							".price-estimate-box",
						).classList.remove("hidden");
					}
				}

				function validateStep(stepNum) {
					let isValid = true;
					const stepEl = document.querySelector(
						`.wizard-step[data-step="${stepNum}"]`,
					);

					if (stepNum === 2) {
						// Step 2 validation: Message is required
						const messageInput = document.getElementById("message");
						if (!messageInput.value.trim()) {
							messageInput.style.borderColor = "#f44336";
							messageInput.focus();
							isValid = false;
						} else {
							messageInput.style.borderColor = "";
						}
					}

					if (stepNum === 3) {
						// Step 3 validation: Contact details
						const nameInput = document.getElementById("name");
						const emailInput = document.getElementById("email");

						if (!nameInput.value.trim()) {
							nameInput.style.borderColor = "#f44336";
							nameInput.focus();
							isValid = false;
						} else {
							nameInput.style.borderColor = "";
						}

						if (
							!emailInput.value.trim() ||
							!emailInput.value.includes("@")
						) {
							emailInput.style.borderColor = "#f44336";
							if (isValid) emailInput.focus();
							isValid = false;
						} else {
							emailInput.style.borderColor = "";
						}

						if (
							isB2bCheckbox.checked &&
							!companyInput.value.trim()
						) {
							companyInput.style.borderColor = "#f44336";
							if (isValid) companyInput.focus();
							isValid = false;
						} else {
							companyInput.style.borderColor = "";
						}

						if (hasAddressCheckbox.checked) {
							[streetInput, zipInput, cityInput].forEach((el) => {
								if (!el.value.trim()) {
									el.style.borderColor = "#f44336";
									if (isValid) el.focus();
									isValid = false;
								} else {
									el.style.borderColor = "";
								}
							});
						}
					}

					return isValid;
				}

				function buildSummary() {
					const summaryBody = document.getElementById("summary-body");
					const additionalSongsCount = Math.round(
						parseFloat(songsSlider.value || 0),
					);

					let summaryHtml = `
							<tr>
								<td>Ausgewähltes Paket:</td>
								<td>${packageInput.value}</td>
							</tr>
							<tr>
								<td>Songs Gesamt:</td>
								<td>${1 + additionalSongsCount} (1 Basis + ${additionalSongsCount} zusätzliche)</td>
							</tr>
							<tr>
								<td>Demo Dateien:</td>
								<td>${accumulatedFiles.length > 0 ? accumulatedFiles.map((f) => f.name).join(", ") : "Keine Dateien hochgeladen"}</td>
							</tr>
							<tr>
								<td>Express Lieferung:</td>
								<td>${expressCheckbox.checked ? "Ja (48h)" : "Nein"}</td>
							</tr>
							<tr>
								<td>Nachricht:</td>
								<td>${document.getElementById("message").value}</td>
							</tr>
							<tr>
								<td>Kontaktperson:</td>
								<td>${document.getElementById("name").value} (${document.getElementById("email").value})</td>
							</tr>
						`;

					if (isB2bCheckbox.checked) {
						summaryHtml += `
								<tr>
									<td>B2B:</td>
									<td>${companyInput.value} ${vatInput.value ? `(USt-IdNr: ${vatInput.value})` : ""}</td>
								</tr>
							`;
					}

					if (hasAddressCheckbox.checked) {
						summaryHtml += `
								<tr>
									<td>Rechnungsadresse:</td>
									<td>${streetInput.value}, ${zipInput.value} ${cityInput.value}, ${countryInput.options[countryInput.selectedIndex].text}</td>
								</tr>
							`;
					}

					summaryHtml += `
							<tr style="border-top: 2px solid #a891ff; font-weight: bold;">
								<td style="color:#a891ff;">Gesamtbetrag (geschätzt):</td>
								<td style="color:#a891ff; font-size: 1.25em;">${currentTotal}€</td>
							</tr>
						`;

					summaryBody.innerHTML = summaryHtml;
				}

				// Clickable Progressbar Navigation
				progressbarItems.forEach((item) => {
					item.addEventListener("click", () => {
						const targetStep = parseInt(
							item.getAttribute("data-step") || 1,
						);
						if (targetStep === currentStep) return;

						if (targetStep < currentStep) {
							// Always allowed to go backward
							showStep(targetStep);
						} else {
							// Going forward: validate all steps up to the targeted step
							let canNavigate = true;
							for (let s = currentStep; s < targetStep; s++) {
								if (!validateStep(s)) {
									canNavigate = false;
									break;
								}
							}
							if (canNavigate) {
								showStep(targetStep);
							}
						}
					});
				});

				// Button clicks
				nextBtn.addEventListener("click", () => {
					if (validateStep(currentStep)) {
						showStep(currentStep + 1);
					}
				});

				prevBtn.addEventListener("click", () => {
					showStep(currentStep - 1);
				});

				// Form Submission
				form.addEventListener("submit", async (e) => {
					e.preventDefault();

					// Honeypot check
					if (document.getElementById("website").value.trim()) {
						formStatus.style.display = "block";
						formStatus.style.background = "rgba(244, 67, 54, 0.1)";
						formStatus.style.border = "1px solid #f44336";
						formStatus.style.color = "#f44336";
						formStatus.innerText = "Spam-Aktivität erkannt.";
						return;
					}

					// Set current timestamp for spam verification
					document.getElementById("form-token").value = Date.now();

					submitBtn.disabled = true;
					loadingWrapper.style.display = "block";
					formStatus.style.display = "none";

					const formData = new FormData(form);
					// Remove the empty native file input entries and append accumulated files
					formData.delete("song_demo");
					accumulatedFiles.forEach((f) => {
						formData.append("song_demo", f, f.name);
					});

					try {
						const response = await fetch("/api/contact", {
							method: "POST",
							body: formData,
						});
						const result = await response.json();

						if (response.ok) {
							formStatus.style.display = "block";
							formStatus.style.background =
								"rgba(203, 178, 255, 0.1)";
							formStatus.style.border = "1px solid #cbb2ff";
							formStatus.style.color = "#cbb2ff";
							formStatus.innerText =
								"Erfolgreich gesendet! Wir haben deine Anfrage erhalten und senden dir in Kürze ein Angebot.";
							form.reset();

							// Reset state
							b2bWrapper.classList.remove("open");
							addressWrapper.classList.remove("open");
							songsSlider.value = 0;
							accumulatedFiles = [];
							renderFileList();
							updateSongsLabel();
							updateTotal();
							updateVisualSlider(true);

							// Navigate back to step 1 after 3 seconds
							setTimeout(() => {
								showStep(1);
								formStatus.style.display = "none";
							}, 3000);
						} else {
							formStatus.style.display = "block";
							formStatus.style.background =
								"rgba(244, 67, 54, 0.1)";
							formStatus.style.border = "1px solid #f44336";
							formStatus.style.color = "#f44336";
							formStatus.innerText =
								result.message ||
								"Etwas ist schiefgelaufen. Bitte versuche es erneut.";
							submitBtn.disabled = false;
						}
					} catch (error) {
						formStatus.style.display = "block";
						formStatus.style.background = "rgba(244, 67, 54, 0.1)";
						formStatus.style.border = "1px solid #f44336";
						formStatus.style.color = "#f44336";
						formStatus.innerText =
							"Fehler bei der Verbindung zum Server.";
						submitBtn.disabled = false;
					} finally {
						loadingWrapper.style.display = "none";
					}
				});

				// Initialize
				updateSongsLabel();
				updateTotal();
				updateVisualSlider(true);
				showStep(1);
			})();
		</script>
	</body>
</html>
