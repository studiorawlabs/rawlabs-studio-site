---
import logo from "../assets/rawlabs logo.png";
import CookieBanner from "../components/CookieBanner.astro";
import PageTransition from "../components/PageTransition.astro";
---

<!doctype html>
<html>
	<head>
		<title>Anfrage - Rawlabs Studios</title>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, user-scalable=no"
		/>
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="stylesheet" href="/assets/css/main.css" />
		<noscript
			><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript
		>
		<style>
			/* Premium Sleek Dark Purple Theme */
			body,
			#wrapper,
			#main,
			section.wrapper {
				background: radial-gradient(
					circle at 50% 0%,
					#190f33 0%,
					#0c0818 100%
				) !important;
				color: #e2dcf0 !important;
			}

			#main.wrapper {
				background: transparent !important;
				padding: 3em 0 6em 0 !important;
			}

			/* Page-wide Progress Bar Stepper (Sticky on scroll) */
			.progress-container-full {
				width: 100%;
				background: rgba(12, 8, 24, 0.9) !important;
				backdrop-filter: blur(12px) !important;
				border-bottom: 1px solid rgba(168, 145, 255, 0.15) !important;
				padding: 1.5em 0;
				margin-bottom: 4em;
				position: sticky;
				top: 0;
				z-index: 100;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
			}
			.progressbar {
				max-width: 800px;
				margin: 0 auto;
				display: flex;
				justify-content: space-between;
				list-style: none;
				padding: 0 1.5em;
				position: relative;
			}
			.progressbar::before {
				content: "";
				position: absolute;
				top: 20px;
				left: 10%;
				right: 10%;
				height: 3px;
				background: rgba(255, 255, 255, 0.08);
				z-index: 0;
				border-radius: 2px;
			}
			.progressbar li {
				flex: 1;
				text-align: center;
				position: relative;
				z-index: 1;
				font-size: 0.85em;
				color: rgba(255, 255, 255, 0.4);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				cursor: pointer;
				transition: color 0.3s ease;
			}
			.progressbar li:hover {
				color: rgba(255, 255, 255, 0.8);
			}
			.progressbar li .step-num {
				width: 42px;
				height: 42px;
				line-height: 38px;
				border: 2px solid rgba(255, 255, 255, 0.15);
				border-radius: 50%;
				display: block;
				margin: 0 auto 0.6em auto;
				background: #0f0a1c;
				font-weight: bold;
				color: rgba(255, 255, 255, 0.5);
				transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			}
			.progressbar li.active {
				color: #a891ff;
				font-weight: bold;
			}
			.progressbar li.active .step-num {
				border-color: #a891ff;
				color: #fff;
				background: #a891ff;
				box-shadow: 0 0 20px rgba(168, 145, 255, 0.6);
				transform: scale(1.1);
			}
			.progressbar li.completed {
				color: #cbb2ff;
			}
			.progressbar li.completed .step-num {
				border-color: #cbb2ff;
				color: #fff;
				background: #cbb2ff;
				box-shadow: 0 0 15px rgba(203, 178, 255, 0.4);
			}

			/* Wizard steps logic */
			.wizard-step {
				display: none;
				animation: fadeIn 0.5s cubic-bezier(0.165, 0.84, 0.44, 1)
					forwards;
			}
			.wizard-step.active {
				display: block;
			}
			@keyframes fadeIn {
				from {
					opacity: 0;
					transform: translateY(15px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			/* Spacious, Premium Form Elements */
			input[type="text"],
			input[type="email"],
			textarea,
			select {
				background: rgba(255, 255, 255, 0.02) !important;
				border: 1px solid rgba(255, 255, 255, 0.1) !important;
				border-radius: 10px !important;
				padding: 1em 1.25em !important;
				color: #fff !important;
				font-size: 0.95em !important;
				transition: all 0.3s ease !important;
				width: 100%;
			}
			select {
				padding: 0.75em 1.25em !important;
				height: auto !important;
				line-height: 1.5 !important;
				text-overflow: ellipsis !important;
			}
			input[type="text"]:focus,
			input[type="email"]:focus,
			textarea:focus,
			select:focus {
				border-color: #a891ff !important;
				box-shadow: 0 0 15px rgba(168, 145, 255, 0.25) !important;
				background: rgba(255, 255, 255, 0.04) !important;
			}

			label {
				font-weight: 600;
				letter-spacing: 0.02em;
				margin-bottom: 0.6em;
				color: rgba(255, 255, 255, 0.85);
			}

			.field {
				margin-bottom: 2em;
			}

			.fields {
				margin-bottom: 0;
			}

			/* Styled Package Selection Buttons - Sleek Glassmorphism */
			.package-button-group {
				display: flex;
				gap: 1.5em;
				margin-top: 1.2em;
				margin-bottom: 2.5em;
			}
			@media screen and (max-width: 736px) {
				.package-button-group {
					flex-direction: column;
					gap: 1em;
				}
			}
			.package-btn {
				flex: 1;
				background: rgba(255, 255, 255, 0.02) !important;
				border: 1px solid rgba(255, 255, 255, 0.1) !important;
				color: rgba(255, 255, 255, 0.75);
				padding: 2.2em 1.5em !important;
				border-radius: 16px;
				cursor: pointer;
				text-align: center;
				transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
				height: auto !important;
				line-height: normal !important;
				display: flex !important;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				white-space: normal !important;
			}
			.package-btn:hover {
				border-color: rgba(168, 145, 255, 0.4) !important;
				color: #fff;
				background: rgba(168, 145, 255, 0.04) !important;
				transform: translateY(-4px);
				box-shadow: 0 8px 25px rgba(168, 145, 255, 0.1);
			}
			.package-btn.active {
				background: rgba(168, 145, 255, 0.12) !important;
				border-color: #a891ff !important;
				color: #fff;
				transform: translateY(-4px);
				box-shadow: 0 0 30px rgba(168, 145, 255, 0.35) !important;
			}
			.package-btn h3 {
				margin: 0 0 0.4em 0;
				font-size: 1.3em;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
			}
			.package-btn p {
				margin: 0;
				font-size: 1.5em;
				font-weight: bold;
				color: #a891ff;
			}

			/* Slider improvements */
			.slider-wrapper {
				position: relative;
				padding: 1.5em 0;
			}
			.songs-slider {
				-webkit-appearance: none;
				appearance: none;
				width: 100%;
				height: 22px;
				background: transparent !important;
				outline: none;
				position: relative;
				z-index: 5;
				cursor: pointer;
				margin: 0 !important;
				padding: 0 !important;
				border: none !important;
			}
			.songs-slider::-webkit-slider-thumb {
				-webkit-appearance: none;
				appearance: none;
				width: 24px;
				height: 22px;
				background: transparent;
				cursor: pointer;
			}
			.songs-slider::-moz-range-thumb {
				width: 24px;
				height: 22px;
				background: transparent;
				border: none;
				cursor: pointer;
			}
			.songs-slider::-moz-range-track {
				background: transparent;
				border: none;
			}
			.songs-slider::-moz-focus-outer {
				border: 0;
			}

			/* Custom Visual Slider Elements */
			.custom-slider-track {
				position: absolute;
				left: 0;
				right: 0;
				top: 50%;
				transform: translateY(-50%);
				height: 8px;
				background: rgba(255, 255, 255, 0.08);
				border-radius: 4px;
				z-index: 1;
				pointer-events: none;
				overflow: hidden;
			}
			.custom-slider-fill {
				width: 11px;
				height: 100%;
				background: #a891ff;
				border-radius: 4px;
				transition: width 0.15s cubic-bezier(0.25, 0.8, 0.25, 1.15);
			}
			.custom-slider-thumb {
				position: absolute;
				top: 50%;
				left: 11px;
				width: 22px;
				height: 22px;
				background: #a891ff;
				border-radius: 50%;
				box-shadow: 0 0 15px rgba(168, 145, 255, 0.6);
				transform: translate(-50%, -50%) scale(1);
				z-index: 2;
				pointer-events: none;
				transition:
					left 0.15s cubic-bezier(0.25, 0.8, 0.25, 1.15),
					transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275),
					box-shadow 0.25s ease;
			}

			/* Custom visual states controlled via real input hover/active sibling rules */
			.songs-slider:hover ~ .custom-slider-thumb {
				transform: translate(-50%, -50%) scale(1.2);
				box-shadow: 0 0 20px rgba(168, 145, 255, 0.9);
			}
			.songs-slider:active ~ .custom-slider-thumb {
				transform: translate(-50%, -50%) scale(1.35);
				box-shadow: 0 0 25px rgba(168, 145, 255, 0.95);
			}

			/* Widescreen centered single-column layout */
			.inner {
				max-width: 1000px !important;
				width: 90% !important;
				margin: 0 auto !important;
				padding: 3em 2em !important;
			}
			.form-container-card {
				background: rgba(255, 255, 255, 0.01);
				border: 1px solid rgba(168, 145, 255, 0.08);
				backdrop-filter: blur(10px);
				padding: 3em;
				border-radius: 20px;
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
				display: flex;
				flex-direction: column;
				gap: 1.5em;
			}
			@media screen and (max-width: 736px) {
				.form-container-card {
					padding: 1.5em;
				}
			}

			/* Price Estimate Box */
			.price-estimate-box {
				background: rgba(255, 255, 255, 0.02) !important;
				backdrop-filter: blur(12px) !important;
				padding: 2em !important;
				border-radius: 16px !important;
				border: 1px solid rgba(168, 145, 255, 0.18) !important;
				display: flex !important;
				flex-direction: column !important;
				gap: 0 !important;
				margin-top: 2em !important;
				box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2) !important;
				transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
				width: 100% !important;
			}
			.price-estimate-box.hidden {
				display: none !important;
			}
			.price-row {
				display: flex !important;
				justify-content: space-between !important;
				align-items: center !important;
				padding: 0.8em 0 !important;
				font-size: 0.98em !important;
				width: 100% !important;
			}
			.price-row:not(:last-child):not(.subtotal-row):not(.discount-row) {
				border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
			}
			.price-row.total-row {
				border-top: 1px solid rgba(168, 145, 255, 0.3) !important;
				padding-top: 1.2em !important;
				font-size: 1.3em !important;
				font-weight: bold;
				color: #a891ff !important;
			}
			.price-row.total-row .price-amount {
				font-size: 1.4em !important;
			}
			.subtotal-row,
			.discount-row {
				max-height: 0px !important;
				opacity: 0 !important;
				padding: 0 !important;
				overflow: hidden !important;
				border-bottom: 0px solid rgba(255, 255, 255, 0.05) !important;
				transition:
					max-height 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
					opacity 0.35s ease,
					padding 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
					border-bottom-width 0.4s ease !important;
				visibility: hidden;
				display: flex !important;
			}
			.subtotal-row.show,
			.discount-row.show {
				max-height: 60px !important;
				opacity: 1 !important;
				padding: 0.8em 0 !important;
				border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
				visibility: visible;
			}
			.discount-row {
				color: #cbb2ff !important;
			}
			.discount-amount {
				font-weight: bold !important;
			}
			.price-breakdown {
				margin-bottom: 0.5em !important;
				width: 100% !important;
			}
			.breakdown-row {
				display: flex !important;
				flex-direction: row !important;
				justify-content: space-between !important;
				align-items: center !important;
				max-height: 0px !important;
				opacity: 0 !important;
				padding: 0 !important;
				overflow: hidden !important;
				border-bottom: 0px solid rgba(255, 255, 255, 0.05) !important;
				transition:
					max-height 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
					opacity 0.35s ease,
					padding 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
					border-bottom-width 0.4s ease !important;
				width: 100% !important;
				visibility: hidden;
			}
			.breakdown-row.show {
				max-height: 60px !important;
				opacity: 1 !important;
				padding: 0.6em 0 !important;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
				visibility: visible;
			}
			.breakdown-details {
				display: flex !important;
				flex-direction: row !important;
				align-items: center !important;
				gap: 0.8em !important;
			}
			.breakdown-qty {
				font-weight: bold !important;
				color: #a891ff !important;
				background: rgba(168, 145, 255, 0.1) !important;
				padding: 0.25em 0.6em !important;
				border-radius: 6px !important;
				font-size: 0.85em !important;
				letter-spacing: 0.02em !important;
				display: inline-block !important;
			}
			.breakdown-name {
				color: rgba(255, 255, 255, 0.85) !important;
				font-weight: 500 !important;
				display: inline-block !important;
			}
			.breakdown-price {
				color: #a891ff !important;
				font-weight: bold !important;
				display: inline-block !important;
				margin-left: auto !important;
			}
			.price-disclaimer {
				font-size: 0.8em !important;
				opacity: 0.5 !important;
				text-align: right !important;
				margin-top: 0.8em !important;
				margin-bottom: 0 !important;
			}

			/* Checkboxes & B2B/Address sections */
			.checkbox-item {
				display: flex;
				align-items: center;
				margin: 0.8em 0;
			}
			.checkbox-item input[type="checkbox"] {
				opacity: 0;
				position: absolute;
			}
			.checkbox-item label {
				position: relative;
				padding-left: 2.5em !important;
				cursor: pointer;
				user-select: none;
				color: rgba(255, 255, 255, 0.8) !important;
				font-weight: 500;
				display: inline-block;
				margin-bottom: 0;
			}
			.checkbox-item label::before {
				content: "";
				position: absolute;
				left: 0;
				top: 50%;
				transform: translateY(-50%);
				width: 22px;
				height: 22px;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 6px;
				transition: all 0.3s;
			}
			.checkbox-item label::after {
				content: "";
				position: absolute;
				left: 8px;
				top: calc(50% - 6px);
				width: 6px;
				height: 11px;
				border: solid #fff;
				border-width: 0 2px 2px 0;
				transform: rotate(45deg) scale(0);
				transition: all 0.25s;
			}
			.checkbox-item input[type="checkbox"]:checked + label::before {
				background: #a891ff;
				border-color: #a891ff;
				box-shadow: 0 0 12px rgba(168, 145, 255, 0.5);
			}
			.checkbox-item input[type="checkbox"]:checked + label::after {
				transform: rotate(45deg) scale(1);
			}

			/* Conditional toggling container animations */
			.collapsible-wrapper {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 0.35s
					cubic-bezier(0.165, 0.84, 0.44, 1);
				overflow: hidden;
			}
			.collapsible-wrapper.open {
				grid-template-rows: 1fr;
				margin-top: 1.5em;
				margin-bottom: 1.5em;
			}
			.collapsible-content {
				min-height: 0;
				overflow: hidden;
				border-left: 2px solid #a891ff;
				padding-left: 2em;
			}

			/* Navigation buttons */
			.navigation-buttons {
				display: flex;
				justify-content: space-between;
				margin-top: 3.5em;
				gap: 1.5em;
			}
			.navigation-buttons button {
				min-width: 140px;
				padding: 0.8em 2em !important;
				height: auto !important;
				line-height: normal !important;
				border-radius: 10px !important;
			}

			/* File upload field styling */
			.file-upload-wrapper {
				display: flex;
				align-items: center;
				margin-top: 0.8em;
				gap: 1.5em;
			}
			.hidden-file-input {
				width: 0.1px;
				height: 0.1px;
				opacity: 0;
				overflow: hidden;
				position: absolute;
				z-index: -1;
			}
			.file-list {
				margin-top: 0.8em;
				display: flex;
				flex-direction: column;
				gap: 0.5em;
			}
			.file-list-item {
				display: flex;
				align-items: center;
				gap: 0.8em;
				padding: 0.5em 0.8em;
				background: rgba(168, 145, 255, 0.06);
				border: 1px solid rgba(168, 145, 255, 0.15);
				border-radius: 8px;
				font-size: 0.9em;
				color: rgba(255, 255, 255, 0.85);
				animation: fadeIn 0.3s ease forwards;
			}
			.file-list-item .file-icon {
				color: #a891ff;
				flex-shrink: 0;
			}
			.file-list-item .file-name {
				flex: 1;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.file-list-item .file-size {
				color: rgba(255, 255, 255, 0.4);
				font-size: 0.85em;
				flex-shrink: 0;
			}
			.file-list-item .file-remove {
				background: none;
				border: none;
				color: rgba(255, 255, 255, 0.4);
				cursor: pointer;
				padding: 0.2em 0.4em;
				font-size: 1.1em;
				line-height: 1;
				border-radius: 4px;
				transition: all 0.2s ease;
				flex-shrink: 0;
				height: auto !important;
				min-width: auto;
			}
			.file-list-item .file-remove:hover {
				color: #f44336;
				background: rgba(244, 67, 54, 0.1);
			}

			/* Summary Table step 4 */
			.summary-table {
				width: 100%;
				margin-top: 2em;
				margin-bottom: 2.5em;
				border-collapse: collapse;
			}
			.summary-table td {
				padding: 1em;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}
			.summary-table td:first-child {
				font-weight: bold;
				width: 35%;
				color: rgba(255, 255, 255, 0.6);
			}

			.loading-bar-wrapper {
				width: 100%;
				background: rgba(255, 255, 255, 0.05);
				height: 4px;
				border-radius: 2px;
				overflow: hidden;
				margin-top: 1.5em;
				display: none;
			}
			.loading-bar {
				width: 30%;
				height: 100%;
				background: #a891ff;
				animation: loading-pulse 1.5s infinite linear;
			}
			@keyframes loading-pulse {
				0% {
					transform: translateX(-100%);
				}
				100% {
					transform: translateX(330%);
				}
			}
		</style>
	</head>
	<body class="is-preload">
		<PageTransition />
		<!-- Header -->
		<header id="header">
			<a href="/" class="title" style="border-bottom: none;"
				><img
					src={logo.src}
					alt="Rawlabs Logo"
					style="height: 2.5em; vertical-align: middle;"
				/></a
			>
			<nav>
				<ul>
					<li>
						<a
							href="/"
							class="button small icon solid fa-chevron-left"
							>Zurück zum Studio</a
						>
					</li>
				</ul>
			</nav>
		</header>

		<!-- Wrapper -->
		<div id="wrapper">
			<!-- Stepper Progress Bar (Spans full page width) -->
			<div class="progress-container-full">
				<ul class="progressbar" id="progressbar">
					<li class="active" data-step="1">
						<span class="step-num">1</span>Paket
					</li>
					<li data-step="2">
						<span class="step-num">2</span>Details
					</li>
					<li data-step="3">
						<span class="step-num">3</span>Kontakt
					</li>
					<li data-step="4">
						<span class="step-num">4</span>Übersicht
					</li>
				</ul>
			</div>

			<!-- Main -->
			<section id="main" class="wrapper style1">
				<div class="inner">
					<h1
						class="major"
						style="margin-bottom: 0.3em; text-align: center;"
					>
						Projekt anfragen
					</h1>
					<p
